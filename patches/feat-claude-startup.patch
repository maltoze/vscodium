+		const loginStatus = document.createElement('div');
+		loginStatus.id = 'loginStatus';
+		loginStatus.className = 'login-status';
+		const userIcon = document.createElement('span');
+		userIcon.className = 'user-icon';
+		userIcon.textContent = '👤';
+		const statusTextZh = document.createElement('span');
+		statusTextZh.className = 'lang-zh';
+		statusTextZh.textContent = '未登录';
+		const statusTextEn = document.createElement('span');
+		statusTextEn.className = 'lang-en';
+		statusTextEn.style.display = 'none';
+		statusTextEn.textContent = 'Not logged in';
+		const hintZh = document.createElement('span');
+		hintZh.className = 'login-hint lang-zh';
+		hintZh.textContent = '(点击登录)';
+		const hintEn = document.createElement('span');
+		hintEn.className = 'login-hint lang-en';
+		hintEn.style.display = 'none';
