+	private createStars(): void {
+		const starField = this.splashContainer?.querySelector(
+			'#starField'
+		) as HTMLElement;
+		if (!starField) {
+			return;
+		}
+
+		const starCount = 150;
+		for (let i = 0; i < starCount; i++) {
+			const star = document.createElement('div');
+			star.className = 'star';
+
+			const size = Math.random() * 2;
+			star.style.width = `${size}px`;
+			star.style.height = `${size}px`;
+
+			const x = Math.random() * 100;
+			const y = Math.random() * 100;
+			star.style.left = `${x}%`;
+			star.style.top = `${y}%`;
+
+			star.style.opacity = String(Math.random() * 0.7 + 0.3);
+
+			const duration = 3 + Math.random() * 7;
+			star.style.animation = `pulse ${duration}s infinite`;
+
+			starField.appendChild(star);
+		}
+	}
+
+	private setupCarousel(): void {
+		const slides = this.splashContainer?.querySelectorAll(
+			'.slide'
+		) as NodeListOf<HTMLElement>;
+		const dots = this.splashContainer?.querySelectorAll(
+			'.carousel-dot'
+		) as NodeListOf<HTMLElement>;
+
+		if (!slides || !dots) {
+			return;
+		}
+
+		const showSlide = (index: number) => {
+			slides.forEach((slide) => slide.classList.remove('active'));
+			dots.forEach((dot) => dot.classList.remove('active'));
+
+			slides[index].classList.add('active');
+			dots[index].classList.add('active');
+			this.currentSlide = index;
+		};
+
+		const nextSlide = () => {
+			this.currentSlide = (this.currentSlide + 1) % slides.length;
+			showSlide(this.currentSlide);
+		};
+
+		dots.forEach((dot, index) => {
+			this._register(
+				addDisposableListener(dot, EventType.CLICK, () => {
+					showSlide(index);
+					this.resetCarouselInterval();
+				})
+			);
+		});
+
+		this.carouselInterval = setInterval(nextSlide, 5000);
+
+		const carouselContainer = this.splashContainer?.querySelector(
+			'.carousel-container'
+		) as HTMLElement;
+		if (carouselContainer) {
+			this._register(
+				addDisposableListener(
+					carouselContainer,
+					EventType.MOUSE_ENTER,
+					() => {
+						clearInterval(this.carouselInterval);
+					}
+				)
+			);
+
+			this._register(
+				addDisposableListener(
+					carouselContainer,
+					EventType.MOUSE_LEAVE,
+					() => {
+						this.resetCarouselInterval();
+					}
+				)
+			);
+		}
+	}
+
+	private resetCarouselInterval(): void {
+		clearInterval(this.carouselInterval);
+		this.carouselInterval = setInterval(() => {
+			this.currentSlide = (this.currentSlide + 1) % 4;
+			const slides = this.splashContainer?.querySelectorAll(
+				'.slide'
+			) as NodeListOf<HTMLElement>;
+			const dots = this.splashContainer?.querySelectorAll(
+				'.carousel-dot'
+			) as NodeListOf<HTMLElement>;
+
+			slides.forEach((slide) => slide.classList.remove('active'));
+			dots.forEach((dot) => dot.classList.remove('active'));
+
+			slides[this.currentSlide].classList.add('active');
+			dots[this.currentSlide].classList.add('active');
+		}, 5000);
+	}
+
+	private updateCarouselWithBannerData(): void {
+		// If no banner data was fetched, keep using default slides
+		if (this.slidesData.length === 0) {
+			return;
+		}
+
+		// Carousel is already showing default slides, no need to update
+		// Banner data will be used on next app launch
+	}
+
+	private addEventListeners(): void {
+		if (!this.splashContainer) {
+			return;
+		}
+
+		const langSwitch = this.splashContainer.querySelector(
+			'#langSwitch'
+		) as HTMLElement;
+		if (langSwitch) {
+			this._register(
+				addDisposableListener(langSwitch, EventType.CLICK, async () => {
+					await this.toggleLanguage();
+				})
+			);
+		}
+
+		const startButton = this.splashContainer.querySelector(
+			'#startButton'
+		) as HTMLElement;
+		if (startButton) {
+			this._register(
+				addDisposableListener(startButton, EventType.CLICK, () => {
+					this.handleStartButtonClick();
+				})
+			);
+		}
+
+		const loginStatus = this.splashContainer.querySelector(
+			'#loginStatus'
+		) as HTMLElement;
+		if (loginStatus) {
+			this._register(
+				addDisposableListener(loginStatus, EventType.CLICK, () => {
+					this.triggerLoginIfNeeded();
+				})
+			);
+		}
+	}
+
+	private async toggleLanguage(): Promise<void> {
+		try {
+			// Determine target language (toggle between Chinese and English)
+			const targetLocale = this.currentLanguage === 'en' ? 'zh-cn' : 'en';
+
+			// Switch to target language
+			const languagePackItem = {
+				id: targetLocale,
+				label: targetLocale === 'zh-cn' ? '中文' : 'English',
+				galleryExtension: undefined,
+				extensionId: undefined
+			};
+
+			// Use VSCode's locale service to switch language
+			// This will restart the application
+			await this.localeService.setLocale(languagePackItem, false);
+		} catch (error) {
+			console.error('Error toggling language:', error);
+		}
+	}
+
+	private handleStartButtonClick(): void {
+		// Prevent action if still loading user info
+		if (this.isLoadingUserInfo) {
+			return;
+		}
+
+		const token = this.storageService.get(
+			TOKEN_STORAGE_KEY,
+			StorageScope.APPLICATION
+		);
+		if (token) {
+			// Check if user needs to subscribe before hiding splash
+			if (
+				typeof this.totalAmount === 'number' &&
+				this.totalAmount <= 0.05
+			) {
+				this.showInsufficientBalanceDialog(token);
+			}
+			this.hideSplash();
+			return;
+		}
+		this.triggerLoginIfNeeded();
+	}
