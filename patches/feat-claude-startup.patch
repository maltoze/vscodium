+				detail: localize2('insufficientBalanceDetail', 'Your account balance is insufficient. Click OK to go to the recharge page.').value,
+				primaryButton: localize2('ok', 'OK').value,
+				cancelButton: localize2('cancel', 'Cancel').value,
+			})
+			.then((result) => {
+				if (result.confirmed) {
+					const subscriptionUrl = `https://deployai365.com/subscription-plans?serviceType=depcoder&instanceId=${INSTANCE_ID}&token=${encodeURIComponent(
+						token
+					)}&successUrl=${encodeURIComponent('vscodium://')}`;
+					this.openerService.open(URI.parse(subscriptionUrl), {
+						openExternal: true,
+					});
+				}
+			});
+	}
+
+	private async checkUserAndSubscription(token: string): Promise<void> {
+		try {
+			const response = await fetch(USER_INFO_API, {
+				headers: {
+					Authorization: `Bearer ${token}`,
+				},
+			});
+
+			if (response.ok) {
+				const data = await response.json();
+				this.userName = data?.data?.user_name;
+				this.totalAmount = data?.data?.total_amount;
+
+				// Check if user needs to subscribe
+				if (
+					typeof this.totalAmount === 'number' &&
+					this.totalAmount <= 0.05
+				) {
+					this.showInsufficientBalanceDialog(token);
+				}
+			}
+		} catch (error) {
+			console.error('Error checking user subscription:', error);
+		}
+	}
+
+	private async fetchAndSaveSubKey(token: string): Promise<void> {
+		try {
+			const response = await fetch(API_ENDPOINT, {
+				method: 'POST',
+				headers: {
+					Authorization: `Bearer ${token}`,
+					'Content-Type': 'application/json',
+				},
+				body: JSON.stringify({
+					instance_id: INSTANCE_ID,
+				}),
+			});
+
+			if (!response.ok) {
+				console.error('Failed to fetch sub key:', response.statusText);
+				return;
+			}
+
+			const data = await response.json();
+			const subKey = data?.data?.sub_key;
+			if (subKey) {
+				this.storageService.store(
+					SUB_KEY_STORAGE_KEY,
+					subKey,
+					StorageScope.APPLICATION,
+					StorageTarget.MACHINE
+				);
+				await this.updateConfigFile(subKey);
+			}
+		} catch (error) {
+			console.error('Error fetching sub key:', error);
+		}
+	}
+
+	private async updateConfigFile(subKey: string): Promise<void> {
+		try {
+			const configPath = await this.getConfigPath();
+			let config: any = { Providers: [{ api_key: '' }] };
+
+			try {
+				const content = await this.fileService.readFile(
+					URI.file(configPath)
+				);
+				config = JSON.parse(content.value.toString());
+			} catch (e) {
+				// File doesn't exist yet, use default config
+			}
+
+			if (!config.Providers) {
+				config.Providers = [];
+			}
+			if (!config.Providers[0]) {
+				config.Providers[0] = {};
+			}
+
+			config.Providers[0].api_key = subKey;
+
+			const content = VSBuffer.fromString(
+				JSON.stringify(config, null, 2)
+			);
+			await this.fileService.writeFile(URI.file(configPath), content);
+			console.log('Config file updated successfully');
+
+			// Restart Claude Code Router CLI
+			await this.hostService.restartClaudeCodeRouterCli();
+		} catch (error) {
+			console.error('Error updating config file:', error);
+		}
+	}
+
+	private async getConfigPath(): Promise<string> {
+		const userHome = await this.pathService.userHome();
+		const homedir = userHome.fsPath;
+		if (isWindows) {
+			return `${homedir}\\.claude-code-router\\config.json`;
+		}
+		return `${homedir}/.claude-code-router/config.json`;
+	}
