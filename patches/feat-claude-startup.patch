+++ b/src/vs/platform/native/electron-main/nativeHostMainService.ts
@@ -1155,2 +1155,45 @@ export class NativeHostMainService extends Disposable implements INativeHostMain
 	}
+
+	async restartClaudeCodeRouterCli(): Promise<void> {
+		const { spawn } = await import('child_process');
+
+		// Get CLI path based on platform and appRoot
+		let cliPath: string;
+		if (isMacintosh) {
+			// appRoot: /path/to/VSCodium.app/Contents/Resources/app
+			// cli: /path/to/VSCodium.app/Contents/Resources/cli
+			const resourcesPath = join(this.environmentMainService.appRoot, '..');
+			cliPath = join(resourcesPath, 'cli');
+		} else if (isWindows) {
+			// appRoot: C:\\...\\VSCodium\\resources\\app
+			// cli: C:\\...\\VSCodium\\resources\\cli.exe
+			const resourcesPath = join(this.environmentMainService.appRoot, '..');
+			cliPath = join(resourcesPath, 'cli.exe');
+		} else {
+			// Linux: appRoot: /usr/share/vscodium/resources/app
+			// cli: /usr/share/vscodium/resources/cli
+			const resourcesPath = join(this.environmentMainService.appRoot, '..');
+			cliPath = join(resourcesPath, 'cli');
+		}
+
+		// Check if CLI exists
+		if (!fs.existsSync(cliPath)) {
+			this.logService.warn(`Claude Code Router CLI not found at: ${cliPath}`);
+			return;
+		}
+
+		this.logService.info(`Restarting Claude Code Router CLI at: ${cliPath}`);
+
+		// Execute CLI restart command
+		try {
+			const child = spawn(cliPath, ['restart'], {
+				detached: true,
+				stdio: 'ignore'
+			});
+			child.unref();
+			this.logService.info('Claude Code Router CLI restart command executed successfully');
+		} catch (error) {
+			this.logService.error('Failed to restart Claude Code Router CLI:', error);
+		}
+	}
 }
