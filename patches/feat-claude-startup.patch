+	private async saveCustomEndpoint(): Promise<void> {
+		if (!this.customModelNameInput || !this.customBaseUrlInput || !this.customApiKeyInput) {
+			this.notificationService.error(
+				localize('deployai.settings.inputFieldsNotInitialized', 'Input fields not initialized')
+			);
+			return;
+		}
+
+		const modelName = this.customModelNameInput.value.trim();
+		const baseUrl = this.customBaseUrlInput.value.trim();
+		const apiKey = this.customApiKeyInput.value.trim();
+
+		if (!modelName || !baseUrl) {
+			this.notificationService.warn(
+				localize('deployai.settings.modelNameAndBaseUrlRequired', 'Model name and API Base URL are required')
+			);
+			return;
+		}
+
+		// Test connection
+		this.notificationService.info(
+			localize('deployai.settings.testingConnection', 'Testing connection...')
+		);
+
+		try {
+			// Test endpoint connectivity with a minimal chat completion request
+			const testUrl = baseUrl;
+			const headers: HeadersInit = {
+				'Content-Type': 'application/json'
+			};
+
+			if (apiKey) {
+				headers['Authorization'] = `Bearer ${apiKey}`;
+			}
+
+			const controller = new AbortController();
+			const timeoutId = setTimeout(() => controller.abort(), 60000); // 60 second timeout
+
+			// Send a minimal test request
+			const response = await fetch(testUrl, {
+				method: 'POST',
+				headers,
+				signal: controller.signal,
+				body: JSON.stringify({
+					model: modelName,
+					messages: [{ role: 'user', content: 'test' }],
+					max_tokens: 1
+				})
+			});
+
+			clearTimeout(timeoutId);
+
+			// Accept both 200 OK and 400/401 as signs the endpoint exists
+			// 400 might mean invalid request format
+			if (!response.ok && response.status !== 400) {
+				throw new Error(`HTTP ${response.status}: ${response.statusText}`);
+			}
+
+			// Connection successful, save configuration
+			const configJson = await this.hostService.readClaudeCodeRouterConfig();
+			let config: any;
+
+			if (configJson) {
+				config = JSON.parse(configJson);
+			} else {
+				config = { Providers: [{}], Router: {} };
+			}
+
+			if (!config.Providers) {
+				config.Providers = [];
+			}
+			if (!config.Providers[0]) {
+				config.Providers[0] = {};
+			}
+
+			config.Providers[0].api_base_url = baseUrl;
+			config.Providers[0].api_key = apiKey;
+			config.Providers[0].models = [modelName];
+			config.Providers[0].name = 'deployai';
+
+			config.Router = {
+				default: `deployai,${modelName}`
+			};
+
+			await this.hostService.writeClaudeCodeRouterConfig(JSON.stringify(config, null, 2));
+
+			// Save to storage
+			this.storageService.store(CUSTOM_MODEL_NAME_KEY, modelName, StorageScope.APPLICATION, StorageTarget.MACHINE);
+			this.storageService.store(CUSTOM_BASE_URL_KEY, baseUrl, StorageScope.APPLICATION, StorageTarget.MACHINE);
+			this.storageService.store(CUSTOM_API_KEY_KEY, apiKey, StorageScope.APPLICATION, StorageTarget.MACHINE);
+
+			this.notificationService.info(
+				localize('deployai.settings.connectionSuccessful', 'Connection successful! Configuration saved')
+			);
+		} catch (error: any) {
+			let errorMessage = localize('deployai.settings.connectionFailed', 'Connection failed');
+
+			if (error.name === 'AbortError') {
+				errorMessage = localize('deployai.settings.connectionTimeout', 'Connection timeout, please check the URL');
+			} else if (error.message) {
+				errorMessage = localize('deployai.settings.connectionFailedWithError', 'Connection failed: {0}', error.message);
+			}
+
+			this.notificationService.error(errorMessage);
+			console.error('Error testing custom endpoint:', error);
+		}
+	}
+
+	private loadCustomEndpointConfig(): void {
+		if (!this.customModelNameInput || !this.customBaseUrlInput || !this.customApiKeyInput) {
+			return;
+		}
+
+		// Load saved values from storage
+		const savedModelName = this.storageService.get(CUSTOM_MODEL_NAME_KEY, StorageScope.APPLICATION);
+		const savedBaseUrl = this.storageService.get(CUSTOM_BASE_URL_KEY, StorageScope.APPLICATION);
+		const savedApiKey = this.storageService.get(CUSTOM_API_KEY_KEY, StorageScope.APPLICATION);
+
+		if (savedModelName) {
+			this.customModelNameInput.value = savedModelName;
+		}
+		if (savedBaseUrl) {
+			this.customBaseUrlInput.value = savedBaseUrl;
+		}
+		if (savedApiKey) {
+			this.customApiKeyInput.value = savedApiKey;
+		}
+
+		// Add blur event listeners to update config when inputs lose focus
+		this._register(DOM.addDisposableListener(this.customModelNameInput, DOM.EventType.BLUR, async () => {
+			await this.updateCustomEndpointConfig();
+		}));
+
+		this._register(DOM.addDisposableListener(this.customBaseUrlInput, DOM.EventType.BLUR, async () => {
+			await this.updateCustomEndpointConfig();
+		}));
+
+		this._register(DOM.addDisposableListener(this.customApiKeyInput, DOM.EventType.BLUR, async () => {
+			await this.updateCustomEndpointConfig();
+		}));
+	}
+
+	private async updateCustomEndpointConfig(): Promise<void> {
+		if (!this.useCustomModel) {
+			return;
+		}
+
+		if (!this.customModelNameInput || !this.customBaseUrlInput || !this.customApiKeyInput) {
+			return;
+		}
+
+		const modelName = this.customModelNameInput.value.trim();
+		const baseUrl = this.customBaseUrlInput.value.trim();
+		const apiKey = this.customApiKeyInput.value.trim();
+
+		if (!modelName || !baseUrl) {
+			return;
+		}
+
+		try {
+			const configJson = await this.hostService.readClaudeCodeRouterConfig();
+			let config: any;
+
+			if (configJson) {
+				config = JSON.parse(configJson);
+			} else {
+				config = { Providers: [{}], Router: {} };
+			}
+
+			if (!config.Providers) {
+				config.Providers = [];
+			}
+			if (!config.Providers[0]) {
+				config.Providers[0] = {};
+			}
+
+			config.Providers[0].api_base_url = baseUrl;
+			config.Providers[0].api_key = apiKey;
+			config.Providers[0].models = [modelName];
+			config.Providers[0].name = 'deployai';
+
+			config.Router = {
+				default: `deployai,${modelName}`
+			};
+
+			await this.hostService.writeClaudeCodeRouterConfig(JSON.stringify(config, null, 2));
+
+			// Save to storage
+			this.storageService.store(CUSTOM_MODEL_NAME_KEY, modelName, StorageScope.APPLICATION, StorageTarget.MACHINE);
+			this.storageService.store(CUSTOM_BASE_URL_KEY, baseUrl, StorageScope.APPLICATION, StorageTarget.MACHINE);
+			this.storageService.store(CUSTOM_API_KEY_KEY, apiKey, StorageScope.APPLICATION, StorageTarget.MACHINE);
+
+			console.log('Custom endpoint config updated successfully');
+		} catch (error) {
+			console.error('Error updating custom endpoint config:', error);
+		}
+	}
+
+	private toggleDropdown(): void {
+		this.isDropdownOpen = !this.isDropdownOpen;
+		if (!this.dropdownMenu || !this.dropdownButton) {
+			return;
+		}
+
+		const chevron = this.dropdownButton.querySelector('.chevron') as HTMLElement;
+
+		if (this.isDropdownOpen) {
+			this.dropdownMenu.style.opacity = '1';
+			this.dropdownMenu.style.transform = 'scale(1) translateY(0)';
+			this.dropdownMenu.style.pointerEvents = 'auto';
+			this.dropdownButton.style.borderColor = asCssVariable(focusBorder);
+			if (chevron) {
+				chevron.style.transform = 'rotate(180deg)';
+			}
+			// Clear search and reset filter
+			if (this.searchInput) {
+				this.searchInput.value = '';
+				this.searchTerm = '';
+				this.filteredModels = this.allModels;
+				this.renderModelOptions();
+				// Focus search input
+				setTimeout(() => this.searchInput?.focus(), 50);
+			}
+		} else {
+			this.dropdownMenu.style.opacity = '0';
+			this.dropdownMenu.style.transform = 'scale(0.98) translateY(-8px)';
+			this.dropdownMenu.style.pointerEvents = 'none';
+			this.dropdownButton.style.borderColor = asCssVariable(inputBorder);
+			if (chevron) {
+				chevron.style.transform = 'rotate(0deg)';
+			}
+		}
+	}
+
+	private toggleCustomSection(): void {
+		this.isCustomOpen = !this.isCustomOpen;
+		if (!this.customContent || !this.customChevron) {
+			return;
+		}
+
+		if (this.isCustomOpen) {
+			this.customContent.style.maxHeight = '600px';
+			this.customContent.style.opacity = '1';
+			this.customChevron.style.transform = 'rotate(180deg)';
+		} else {
+			this.customContent.style.maxHeight = '0';
+			this.customContent.style.opacity = '0';
+			this.customChevron.style.transform = 'rotate(0deg)';
+		}
+	}
+
+	override layout(dimension: DOM.Dimension): void {
+		// Layout is handled by CSS
+	}
+
+	override focus(): void {
+		this.container?.focus();
+	}
+}
