+
+interface ModelData {
+	id: string;
+	name: string;
+	description: string;
+	provider_slug: string;
+}
+
+interface ModelsResponse {
+	code: number;
+	data: {
+		total: number;
+		models: ModelData[];
+	};
+	message: string;
+}
+
+export class DeployAISettingsEditor extends EditorPane {
+	static readonly ID = 'workbench.editor.deployaiSettings';
+
+	private container: HTMLElement | undefined;
+	private currentLanguage: string = 'zh';
+	private selectedModel: string = 'anthropic/claude-sonnet-4.5';
+	private useCustomModel: boolean = false;
+	private enableCustomModel: boolean = true;
+	private useClaudeAccountLogin: boolean = false;
+	private isDropdownOpen: boolean = false;
+	private isCustomOpen: boolean = false;
+	private searchTerm: string = '';
+	private allModels: ModelData[] = [];
+	private filteredModels: ModelData[] = [];
+
+	private dropdownButton: HTMLElement | undefined;
+	private dropdownMenu: HTMLElement | undefined;
+	private searchInput: HTMLInputElement | undefined;
+	private modelOptionsContainer: HTMLElement | undefined;
+	private customContent: HTMLElement | undefined;
+	private customChevron: HTMLElement | undefined;
+
+	private customModelNameInput: HTMLInputElement | undefined;
+	private customBaseUrlInput: HTMLInputElement | undefined;
+	private customApiKeyInput: HTMLInputElement | undefined;
+	private customSection: HTMLElement | undefined;
+
+	private themeLightButton: HTMLElement | undefined;
+	private themeDarkButton: HTMLElement | undefined;
+	private claudeLoginButton: HTMLElement | undefined;
+	private localEnvButton: HTMLElement | undefined;
+
+	constructor(
+		group: IEditorGroup,
+		@ITelemetryService telemetryService: ITelemetryService,
+		@IThemeService themeService: IThemeService,
+		@IStorageService private readonly storageService: IStorageService,
+		@ILocaleService private readonly localeService: ILocaleService,
+		@IHostService private readonly hostService: IHostService,
+		@INotificationService private readonly notificationService: INotificationService,
+		@IWorkbenchThemeService private readonly workbenchThemeService: IWorkbenchThemeService,
+		@IConfigurationService private readonly configurationService: IConfigurationService,
+	) {
+		super(DeployAISettingsEditor.ID, group, telemetryService, themeService, storageService);
+		this.initializeLanguage();
+		this.loadEnableCustomModel();
+		this.loadUseCustomModel();
+		this.loadSelectedModel();
+		this.loadUseClaudeAccountLogin();
+		this.fetchModels();
+
+		// Listen to theme changes
+		this._register(this.workbenchThemeService.onDidColorThemeChange(() => {
+			this.updateThemeButtons();
+		}));
+
+		// Listen to storage changes for enable_custom_model
+		this._register(this.storageService.onDidChangeValue(StorageScope.APPLICATION, ENABLE_CUSTOM_MODEL_KEY, this._store)((e) => {
+			this.loadEnableCustomModel();
+			// Re-render model options if dropdown is open
+			if (this.isDropdownOpen && this.modelOptionsContainer) {
+				this.renderModelOptions();
+			}
+		}));
+
+		this._register(this.configurationService.onDidChangeConfiguration((e) => {
+			if (e.affectsConfiguration(USE_CLAUDE_ACCOUNT_LOGIN_KEY)) {
+				this.loadUseClaudeAccountLogin();
+				this.updateClaudeLoginButtons();
+			}
+		}));
+	}
+
+	private loadEnableCustomModel(): void {
+		const saved = this.storageService.get(ENABLE_CUSTOM_MODEL_KEY, StorageScope.APPLICATION);
+		// If saved value exists, use it; otherwise default to true
+		this.enableCustomModel = saved !== undefined ? saved === 'true' : true;
+		console.log('loadEnableCustomModel:', saved, 'enableCustomModel:', this.enableCustomModel);
+	}
+
+	private loadUseCustomModel(): void {
+		const saved = this.storageService.get(USE_CUSTOM_MODEL_KEY, StorageScope.APPLICATION);
+		this.useCustomModel = saved === 'true';
+	}
+
+	private loadSelectedModel(): void {
+		const saved = this.storageService.get(SELECTED_MODEL_KEY, StorageScope.APPLICATION);
+		if (saved) {
+			this.selectedModel = saved;
+		}
+	}
+
+	private loadUseClaudeAccountLogin(): void {
+		this.useClaudeAccountLogin = !!this.configurationService.getValue(USE_CLAUDE_ACCOUNT_LOGIN_KEY);
+	}
+
+	private initializeLanguage(): void {
+		const currentLocale = Language.value() || 'en';
+		this.currentLanguage = currentLocale.startsWith('zh') ? 'zh' : 'en';
+	}
+
+	private async fetchModels(): Promise<void> {
+		try {
+			const response = await fetch('https://modelproxy-api.deployai365.com/api/proxy/models/visible?page=1&pageSize=10000');
+			const data: ModelsResponse = await response.json();
+			if (data.code === 20000 && data.data.models) {
+				this.allModels = data.data.models;
+				this.filteredModels = this.allModels;
+				if (this.allModels.length > 0 && !this.selectedModel) {
+					this.selectedModel = this.allModels[0].id;
+				}
+				if (this.dropdownButton) {
+					this.renderDropdownButton();
+				}
+			}
+		} catch (error) {
+			console.error('Error fetching models:', error);
+		}
+	}
+
+	protected createEditor(parent: HTMLElement): void {
+		this.container = parent;
+		this.render();
+		this.updateStyles();
+	}
+
+	override async setInput(input: DeployAISettingsInput, options: any, context: IEditorOpenContext, token: CancellationToken): Promise<void> {
+		await super.setInput(input, options, context, token);
+	}
+
+	override updateStyles(): void {
+		super.updateStyles();
+		if (this.container) {
+			this.container.style.background = asCssVariable(editorBackground);
+			this.container.style.color = asCssVariable(editorForeground);
+		}
+	}
+
+	private render(): void {
+		if (!this.container) {
+			return;
+		}
+
+		this.container.style.cssText = `background: ${asCssVariable(editorBackground)}; color: ${asCssVariable(editorForeground)}; overflow-y: auto; height: 100%;`;
+
+		const contentWrapper = DOM.append(this.container, DOM.$('.deployai-settings-wrapper'));
+		contentWrapper.style.cssText = 'max-width: 768px; margin: 0 auto; padding: 40px 32px 80px;';
+
+		this.renderHeader(contentWrapper);
+		this.renderGeneralSection(contentWrapper);
+		this.renderModelSection(contentWrapper);
+		this.renderCustomSection(contentWrapper);
+		this.renderFooter(contentWrapper);
+	}
+
+	private renderHeader(parent: HTMLElement): void {
+		const header = DOM.append(parent, DOM.$('.settings-header'));
+		header.style.cssText = `display: flex; align-items: flex-end; justify-content: space-between; border-bottom: 1px solid ${asCssVariable(contrastBorder)}; padding-bottom: 24px; margin-bottom: 40px;`;
+
+		const headerContent = DOM.append(header, DOM.$('.header-content'));
+		const title = DOM.append(headerContent, DOM.$('h1'));
+		title.textContent = localize('deployai.settings.title', 'Settings');
+		title.style.cssText = `font-size: 24px; font-weight: 700; color: ${asCssVariable(editorForeground)}; margin: 0;`;
+
+		const desc = DOM.append(headerContent, DOM.$('p'));
+		desc.textContent = localize('deployai.settings.desc', 'Manage workspace configurations and AI model preferences.');
+		desc.style.cssText = `font-size: 14px; color: ${asCssVariable(editorForeground)}; opacity: 0.7; margin: 4px 0 0;`;
+	}
+
+	private renderGeneralSection(parent: HTMLElement): void {
+		const section = DOM.append(parent, DOM.$('.settings-section'));
+		section.style.cssText = 'margin-bottom: 40px;';
+
+		const sectionTitle = DOM.append(section, DOM.$('h3'));
+		sectionTitle.style.cssText = `font-size: 11px; font-weight: 700; color: ${asCssVariable(editorForeground)}; opacity: 0.6; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 16px; display: flex; align-items: center; gap: 6px;`;
+
+		const titleIcon = DOM.append(sectionTitle, DOM.$('span.codicon.codicon-globe'));
+		titleIcon.style.cssText = 'font-size: 12px;';
+
+		const titleText = DOM.append(sectionTitle, DOM.$('span'));
+		titleText.textContent = localize('deployai.settings.general', 'GENERAL');
+
+		// Theme card
+		const themeCard = DOM.append(section, DOM.$('.settings-card'));
+		themeCard.style.cssText = `background: ${asCssVariable(inputBackground)}; border-radius: 6px; border: 1px solid ${asCssVariable(inputBorder)}; padding: 20px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;`;
+
+		const themeLabelContainer = DOM.append(themeCard, DOM.$('.label-container'));
+		const themeLabel = DOM.append(themeLabelContainer, DOM.$('label'));
+		themeLabel.textContent = localize('deployai.settings.theme', 'Theme');
+		themeLabel.style.cssText = `font-size: 14px; font-weight: 500; color: ${asCssVariable(editorForeground)}; display: block;`;
+
+		const themeLabelDesc = DOM.append(themeLabelContainer, DOM.$('p'));
+		themeLabelDesc.textContent = localize('deployai.settings.themeDesc', 'Select color theme');
+		themeLabelDesc.style.cssText = `font-size: 12px; color: ${asCssVariable(editorForeground)}; opacity: 0.7; margin: 2px 0 0;`;
+
+		const themeToggle = DOM.append(themeCard, DOM.$('.theme-toggle'));
+		themeToggle.style.cssText = `background: ${asCssVariable(editorBackground)}; padding: 4px; border-radius: 6px; display: flex; font-size: 12px; font-weight: 500;`;
+
+		// Get current theme
+		const currentTheme = this.workbenchThemeService.getColorTheme();
+		const isDark = currentTheme.type === ColorScheme.DARK;
+
+		this.themeLightButton = DOM.append(themeToggle, DOM.$('button.theme-btn'));
+		this.themeLightButton.textContent = localize('deployai.settings.lightTheme', 'Light');
+		this.themeLightButton.style.cssText = !isDark
+			? `padding: 6px 16px; border-radius: 4px; transition: all 0.2s; border: none; background: ${asCssVariable(listActiveSelectionBackground)}; cursor: pointer; color: ${asCssVariable(editorForeground)};`
+			: `padding: 6px 16px; border-radius: 4px; transition: all 0.2s; border: none; background: transparent; cursor: pointer; color: ${asCssVariable(editorForeground)}; opacity: 0.7;`;
+
+		this.themeDarkButton = DOM.append(themeToggle, DOM.$('button.theme-btn'));
+		this.themeDarkButton.textContent = localize('deployai.settings.darkTheme', 'Dark');
+		this.themeDarkButton.style.cssText = isDark
+			? `padding: 6px 16px; border-radius: 4px; transition: all 0.2s; border: none; background: ${asCssVariable(listActiveSelectionBackground)}; cursor: pointer; color: ${asCssVariable(editorForeground)};`
+			: `padding: 6px 16px; border-radius: 4px; transition: all 0.2s; border: none; background: transparent; cursor: pointer; color: ${asCssVariable(editorForeground)}; opacity: 0.7;`;
+
+		this._register(DOM.addDisposableListener(this.themeLightButton, DOM.EventType.CLICK, () => this.setTheme('light')));
+		this._register(DOM.addDisposableListener(this.themeDarkButton, DOM.EventType.CLICK, () => this.setTheme('dark')));
+
+		// Language card
+		const card = DOM.append(section, DOM.$('.settings-card'));
+		card.style.cssText = `background: ${asCssVariable(inputBackground)}; border-radius: 6px; border: 1px solid ${asCssVariable(inputBorder)}; padding: 20px; display: flex; align-items: center; justify-content: space-between;`;
+
+		const labelContainer = DOM.append(card, DOM.$('.label-container'));
