+
+		clearInterval(this.carouselInterval);
+
+		this.splashContainer.style.opacity = '0';
+		this.splashContainer.style.transition = 'opacity 0.3s ease-out';
+
+		setTimeout(() => {
+			if (this.splashContainer && this.splashContainer.parentNode) {
+				this.splashContainer.parentNode.removeChild(
+					this.splashContainer
+				);
+			}
+			this.splashContainer = undefined;
+		}, 300);
+	}
+
+	private async updateLoginStatus(allowOpenExternal: boolean = true): Promise<void> {
+		if (!this.splashContainer) {
+			return;
+		}
+		const token = this.storageService.get(
+			TOKEN_STORAGE_KEY,
+			StorageScope.APPLICATION
+		);
+		const statusText = this.splashContainer.querySelector(
+			'#loginStatus .status-text'
+		) as HTMLElement | null;
+		const hint = this.splashContainer.querySelector(
+			'#loginStatus .login-hint'
+		) as HTMLElement | null;
+		const startButton = this.splashContainer.querySelector(
+			'#startButton'
+		) as HTMLButtonElement | null;
+		const btnText = startButton?.querySelector(
+			'.button-text'
+		) as HTMLElement | null;
+		const arrowIcon = startButton?.querySelector(
+			'.arrow-icon'
+		) as HTMLElement | null;
+
+		if (token) {
+			this.isLoadingUserInfo = true;
+			if (startButton) {
+				startButton.disabled = true;
+				startButton.classList.add('loading');
+			}
+			if (btnText) {
+				btnText.textContent = localize2('loading', 'Loading...').value;
+			}
+			if (arrowIcon) {
+				arrowIcon.style.display = 'none';
+			}
+
+			await this.fetchAndSaveSubKey(token);
+
+			// Only fetch user info if we don't have it yet
+			if (!this.userName && !this.totalAmount) {
+				const userInfo = await this.fetchUserInfo(token);
+
+				if (!userInfo) {
+					// Token was invalid and removed, open login page if allowed
+					if (allowOpenExternal) {
+						const callback = URI.from({
+							scheme: CALLBACK_SCHEME,
+							authority: CALLBACK_AUTHORITY,
+							path: CALLBACK_PATH,
+						});
+						const loginUrl = `https://login.deployai365.com/?platform=cline&originUrl=${encodeURIComponent(
+							callback.toString()
+						)}`;
+						this.openerService.open(URI.parse(loginUrl), {
+							openExternal: true,
+						});
+					}
+					return;
+				}
+
+				// Update local state
+				this.userName = userInfo.userName;
+				this.totalAmount = userInfo.totalAmount;
+			}
+
+			// Update UI with existing data
+			if (this.userName && statusText) {
+				statusText.textContent = this.userName;
+			} else if (statusText) {
+				statusText.textContent = localize2('loggedIn', 'Logged in').value;
+			}
+
+			// Remove loading state after fetch completes
+			this.isLoadingUserInfo = false;
+			if (startButton) {
+				startButton.disabled = false;
+				startButton.classList.remove('loading');
+			}
+			if (btnText) {
+				btnText.textContent = localize2('launchClaudeCode', 'Launch Claude Code').value;
+			}
+			if (arrowIcon) {
+				arrowIcon.style.display = '';
+			}
+
+			if (hint) {
+				hint.style.display = 'none';
+			}
+		} else {
+			if (statusText) {
+				statusText.textContent = localize2('notLoggedIn', 'Not logged in').value;
+			}
+			if (hint) {
+				hint.style.display = '';
+			}
+		}
+	}
