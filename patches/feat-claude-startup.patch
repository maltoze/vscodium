+	private async updateConfigFile(modelId: string): Promise<void> {
+		try {
+			// Read current config
+			const configJson = await this.hostService.readClaudeCodeRouterConfig();
+			let config: any;
+
+			if (configJson) {
+				config = JSON.parse(configJson);
+			} else {
+				// Create default config if not exists
+				config = { Providers: [{ models: [] }], Router: {} };
+			}
+
+			// Ensure config structure exists
+			if (!config.Providers) {
+				config.Providers = [];
+			}
+			if (!config.Providers[0]) {
+				config.Providers[0] = {};
+			}
+			if (!config.Providers[0].models) {
+				config.Providers[0].models = [];
+			}
+
+			// Update models array
+			config.Providers[0].models = [modelId];
+			config.Providers[0].api_base_url = MODELPROXY_API_ENDPOINT;
+			const apiKey = this.storageService.get(SUB_KEY_STORAGE_KEY, StorageScope.APPLICATION, '');
+			config.Providers[0].api_key = apiKey;
+			config.Providers[0].name = 'deployai';
+
+			// Update Router
+			config.Router = {
+				default: `deployai,${modelId}`
+			};
+
+			// Write config back
+			await this.hostService.writeClaudeCodeRouterConfig(JSON.stringify(config, null, 2));
+
+			console.log('Config file updated successfully with model:', modelId);
+		} catch (error) {
+			console.error('Error updating config file:', error);
+		}
+	}
