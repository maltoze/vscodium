+	private registerUrlHandler(): void {
+		const handler: IURLHandler = {
+			handleURL: async (uri: URI) => {
+				if (uri.scheme !== CALLBACK_SCHEME) {
+					return false;
+				}
+				if (
+					uri.authority !== CALLBACK_AUTHORITY ||
+					uri.path !== CALLBACK_PATH
+				) {
+					return false;
+				}
+				const params = new URLSearchParams(uri.query ?? '');
+				const token = params.get('token');
+				if (token) {
+					this.storageService.store(
+						TOKEN_STORAGE_KEY,
+						token,
+						StorageScope.APPLICATION,
+						StorageTarget.MACHINE
+					);
+					// Update login state immediately
+					this.isLoggedInContextKey.set(true);
+					// Check user info and total_amount after login
+					await this.checkUserAndSubscription(token);
+					this.updateLoginStatus();
+					this.hideSplash();
+					this.startBalanceCheck();
+					return true;
+				}
+				return false;
+			},
+		};
+		this._register(this.urlService.registerHandler(handler));
+	}
+
