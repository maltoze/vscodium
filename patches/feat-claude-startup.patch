+
+	deserialize(instantiationService: IInstantiationService): DeployAISettingsInput {
+		return instantiationService.createInstance(DeployAISettingsInput);
+	}
+}
+
+Registry.as<IEditorFactoryRegistry>(EditorExtensions.EditorFactory).registerEditorSerializer(
+	DeployAISettingsInput.ID,
+	DeployAISettingsInputSerializer
