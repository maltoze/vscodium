@@ -1155,2 +1155,89 @@ export class NativeHostMainService extends Disposable implements INativeHostMain
 	}
+
+	async restartClaudeCodeRouterCli(): Promise<void> {
+		// Get CLI path based on platform and appRoot
+		let cliPath: string;
+		if (isMacintosh) {
+			// appRoot: /path/to/VSCodium.app/Contents/Resources/app
+			// cli: /path/to/VSCodium.app/Contents/Resources/cli
+			const resourcesPath = join(this.environmentMainService.appRoot, '..');
+			cliPath = join(resourcesPath, 'cli');
+		} else if (isWindows) {
+			// appRoot: C:\\...\\VSCodium\\resources\\app
+			// cli: C:\\...\\VSCodium\\resources\\cli.exe
+			const resourcesPath = join(this.environmentMainService.appRoot, '..');
+			cliPath = join(resourcesPath, 'cli.exe');
+		} else {
+			// Linux: appRoot: /usr/share/vscodium/resources/app
+			// cli: /usr/share/vscodium/resources/cli
+			const resourcesPath = join(this.environmentMainService.appRoot, '..');
+			cliPath = join(resourcesPath, 'cli');
+		}
+
+		// Check if CLI exists
+		if (!fs.existsSync(cliPath)) {
+			this.logService.warn(`Claude Code Router CLI not found at: ${cliPath}`);
+			return;
+		}
+
+		this.logService.info(`Restarting Claude Code Router CLI at: ${cliPath}`);
+
+		// Execute CLI restart command
+		try {
+			const { stdout, stderr } = await promisify(exec)(`"${cliPath}" restart`);
+			if (stdout) {
+				this.logService.info('Claude Code Router CLI restart stdout:', stdout.trim());
+			}
+			if (stderr) {
+				this.logService.warn('Claude Code Router CLI restart stderr:', stderr.trim());
+			}
+			this.logService.info('Claude Code Router CLI restart command executed successfully');
+		} catch (error) {
+			this.logService.error('Failed to restart Claude Code Router CLI:', error);
+		}
+	}
+
+	private async getClaudeCodeRouterConfigPath(): Promise<string> {
+		const userHome = this.environmentMainService.userHome.fsPath;
+		if (isWindows) {
+			return `${userHome}\\.claude-code-router\\config.json`;
+		}
+		return `${userHome}/.claude-code-router/config.json`;
+	}
+
+	async readClaudeCodeRouterConfig(_windowId: number | undefined): Promise<string | undefined> {
+		try {
+			const configPath = await this.getClaudeCodeRouterConfigPath();
+			const content = await fs.promises.readFile(configPath, 'utf-8');
+			this.logService.trace('Successfully read Claude Code Router config');
+			return content;
+		} catch (error) {
+			if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
+				this.logService.trace('Claude Code Router config file does not exist');
+				return undefined;
+			}
+			this.logService.error('Error reading Claude Code Router config:', error);
+			throw error;
+		}
+	}
+
+	async writeClaudeCodeRouterConfig(_windowId: number | undefined, configJson: string): Promise<void> {
+		try {
+			const configPath = await this.getClaudeCodeRouterConfigPath();
+			const configDir = dirname(configPath);
+
+			// Ensure directory exists
+			await fs.promises.mkdir(configDir, { recursive: true });
+
+			// Write config file
+			await fs.promises.writeFile(configPath, configJson, 'utf-8');
+			this.logService.info('Successfully wrote Claude Code Router config');
+
+			// Restart CLI after config update
+			await this.restartClaudeCodeRouterCli();
+		} catch (error) {
+			this.logService.error('Error writing Claude Code Router config:', error);
+			throw error;
+		}
+	}
 }
