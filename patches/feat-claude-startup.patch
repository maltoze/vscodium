+		if (provider.includes('deepseek')) return 'D';
+		if (provider.includes('openai') || provider.includes('gpt')) return 'O';
+		if (provider.includes('meta') || provider.includes('llama')) return 'M';
+		if (provider.includes('mistral')) return 'Mi';
+		return provider.charAt(0).toUpperCase();
+	}
