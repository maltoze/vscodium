+		}
+
+		const starCount = 150;
+		for (let i = 0; i < starCount; i++) {
+			const star = document.createElement('div');
+			star.className = 'star';
+
+			const size = Math.random() * 2;
+			star.style.width = `${size}px`;
+			star.style.height = `${size}px`;
+
+			const x = Math.random() * 100;
+			const y = Math.random() * 100;
+			star.style.left = `${x}%`;
+			star.style.top = `${y}%`;
+
+			star.style.opacity = String(Math.random() * 0.7 + 0.3);
+
+			const duration = 3 + Math.random() * 7;
+			star.style.animation = `pulse ${duration}s infinite`;
+
+			starField.appendChild(star);
+		}
+	}
+
+	private setupCarousel(): void {
+		const slides = this.splashContainer?.querySelectorAll('.slide') as NodeListOf<HTMLElement>;
+		const dots = this.splashContainer?.querySelectorAll('.carousel-dot') as NodeListOf<HTMLElement>;
+
+		if (!slides || !dots) {
+			return;
+		}
+
+		const showSlide = (index: number) => {
+			slides.forEach(slide => slide.classList.remove('active'));
+			dots.forEach(dot => dot.classList.remove('active'));
+
+			slides[index].classList.add('active');
+			dots[index].classList.add('active');
+			this.currentSlide = index;
+		};
+
+		const nextSlide = () => {
+			this.currentSlide = (this.currentSlide + 1) % slides.length;
+			showSlide(this.currentSlide);
+		};
+
+		dots.forEach((dot, index) => {
+			this._register(addDisposableListener(dot, EventType.CLICK, () => {
+				showSlide(index);
+				this.resetCarouselInterval();
+			}));
+		});
+
+		this.carouselInterval = setInterval(nextSlide, 5000);
+
+		const carouselContainer = this.splashContainer?.querySelector('.carousel-container') as HTMLElement;
+		if (carouselContainer) {
+			this._register(addDisposableListener(carouselContainer, EventType.MOUSE_ENTER, () => {
+				clearInterval(this.carouselInterval);
+			}));
+
+			this._register(addDisposableListener(carouselContainer, EventType.MOUSE_LEAVE, () => {
+				this.resetCarouselInterval();
+			}));
+		}
+	}
+
+	private resetCarouselInterval(): void {
+		clearInterval(this.carouselInterval);
+		this.carouselInterval = setInterval(() => {
+			this.currentSlide = (this.currentSlide + 1) % 4;
+			const slides = this.splashContainer?.querySelectorAll('.slide') as NodeListOf<HTMLElement>;
+			const dots = this.splashContainer?.querySelectorAll('.carousel-dot') as NodeListOf<HTMLElement>;
+
+			slides.forEach(slide => slide.classList.remove('active'));
+			dots.forEach(dot => dot.classList.remove('active'));
+
+			slides[this.currentSlide].classList.add('active');
+			dots[this.currentSlide].classList.add('active');
+		}, 5000);
+	}
+
+	private addEventListeners(): void {
+		if (!this.splashContainer) {
+			return;
+		}
+
+		const langSwitch = this.splashContainer.querySelector('#langSwitch') as HTMLElement;
+		if (langSwitch) {
+			this._register(addDisposableListener(langSwitch, EventType.CLICK, () => {
+				this.toggleLanguage();
+			}));
+		}
+
+		const startButton = this.splashContainer.querySelector('#startButton') as HTMLElement;
+		if (startButton) {
+			this._register(addDisposableListener(startButton, EventType.CLICK, () => {
+				this.handleStartButtonClick();
+			}));
+		}
+
+		const loginStatus = this.splashContainer.querySelector('#loginStatus') as HTMLElement;
+		if (loginStatus) {
+			this._register(addDisposableListener(loginStatus, EventType.CLICK, () => {
+				this.triggerLoginIfNeeded();
+			}));
+		}
+
+		const targetWindow = getWindow(this.splashContainer);
+		this._register(addDisposableListener(targetWindow.document, EventType.KEY_DOWN, (e: KeyboardEvent) => {
+			if (e.key === 'Enter' || e.key === ' ') {
+				e.preventDefault();
+				this.handleStartButtonClick();
+			}
+		}));
+	}
+
+	private toggleLanguage(): void {
+		this.currentLang = this.currentLang === 'zh' ? 'en' : 'zh';
+
+		this.storageService.store(LANGUAGE_STORAGE_KEY, this.currentLang, StorageScope.APPLICATION, StorageTarget.MACHINE);
+
+		const langDisplay = this.splashContainer?.querySelector('#langDisplay') as HTMLElement;
+		if (langDisplay) {
+			langDisplay.textContent = this.currentLang === 'zh' ? '中文' : 'English';
+		}
+
+		const zhElements = this.splashContainer?.querySelectorAll('.lang-zh') as NodeListOf<HTMLElement>;
+		const enElements = this.splashContainer?.querySelectorAll('.lang-en') as NodeListOf<HTMLElement>;
+
+		if (this.currentLang === 'zh') {
+			zhElements.forEach(el => el.style.display = '');
+			enElements.forEach(el => el.style.display = 'none');
+		} else {
+			zhElements.forEach(el => el.style.display = 'none');
+			enElements.forEach(el => el.style.display = '');
+		}
+	}
+
+	private handleStartButtonClick(): void {
+		// Prevent action if still loading user info
+		if (this.isLoadingUserInfo) {
+			return;
+		}
+
+		const token = this.storageService.get(TOKEN_STORAGE_KEY, StorageScope.APPLICATION);
+		if (token) {
+			// Check if user needs to subscribe before hiding splash
+			if (typeof this.totalAmount === 'number' && this.totalAmount <= 0) {
+				this.showInsufficientBalanceDialog(token);
+			}
+			this.hideSplash();
+			return;
+		}
+		this.triggerLoginIfNeeded();
+	}
+
+	private triggerLoginIfNeeded(): void {
+		const token = this.storageService.get(TOKEN_STORAGE_KEY, StorageScope.APPLICATION);
+		if (token) {
+			this.updateLoginStatus();
+			return;
+		}
+		const callback = URI.from({ scheme: CALLBACK_SCHEME, authority: CALLBACK_AUTHORITY, path: CALLBACK_PATH });
+		const loginUrl = `https://login.deployai365.com/?platform=cline&originUrl=${encodeURIComponent(callback.toString())}`;
+		this.openerService.open(URI.parse(loginUrl), { openExternal: true });
+	}
+
+	private hideSplash(): void {
+		if (!this.splashContainer) {
+			return;
+		}
+
+		clearInterval(this.carouselInterval);
+
+		this.splashContainer.style.opacity = '0';
+		this.splashContainer.style.transition = 'opacity 0.3s ease-out';
+
+		setTimeout(() => {
+			if (this.splashContainer && this.splashContainer.parentNode) {
+				this.splashContainer.parentNode.removeChild(this.splashContainer);
+			}
+			this.splashContainer = undefined;
+		}, 300);
+	}
+
+	private async updateLoginStatus(): Promise<void> {
+		if (!this.splashContainer) {
+			return;
+		}
+		const token = this.storageService.get(TOKEN_STORAGE_KEY, StorageScope.APPLICATION);
+		const statusZh = this.splashContainer.querySelector('#loginStatus .lang-zh') as HTMLElement | null;
+		const statusEn = this.splashContainer.querySelector('#loginStatus .lang-en') as HTMLElement | null;
+		const hintZh = this.splashContainer.querySelector('#loginStatus .login-hint.lang-zh') as HTMLElement | null;
+		const hintEn = this.splashContainer.querySelector('#loginStatus .login-hint.lang-en') as HTMLElement | null;
+		const startButton = this.splashContainer.querySelector('#startButton') as HTMLButtonElement | null;
+		const btnTextZh = startButton?.querySelector('.lang-zh') as HTMLElement | null;
+		const btnTextEn = startButton?.querySelector('.lang-en') as HTMLElement | null;
+		const arrowIcon = startButton?.querySelector('.arrow-icon') as HTMLElement | null;
+
+		if (token) {
+			this.isLoadingUserInfo = true;
+			if (startButton) {
+				startButton.disabled = true;
+				startButton.classList.add('loading');
+			}
+			if (btnTextZh) { btnTextZh.textContent = '加载中...'; }
+			if (btnTextEn) { btnTextEn.textContent = 'Loading...'; }
+			if (arrowIcon) { arrowIcon.style.display = 'none'; }
+
+			// Fetch user info
+			try {
+				const response = await fetch(USER_INFO_API, {
+					headers: {
+						'Authorization': `Bearer ${token}`
+					}
+				});
+
+				if (response.status === 401) {
+					// Token invalid, trigger login
+					this.storageService.remove(TOKEN_STORAGE_KEY, StorageScope.APPLICATION);
+					const callback = URI.from({ scheme: CALLBACK_SCHEME, authority: CALLBACK_AUTHORITY, path: CALLBACK_PATH });
+					const loginUrl = `https://login.deployai365.com/?platform=cline&originUrl=${encodeURIComponent(callback.toString())}`;
+					this.openerService.open(URI.parse(loginUrl), { openExternal: true });
+					return;
+				}
+
+				if (response.ok) {
+					const data = await response.json();
+					console.log('user info response:', data, JSON.stringify(data));
+					this.userName = data?.data?.user_name;
+					this.totalAmount = data?.data?.total_amount;
+
+					if (this.userName) {
+						if (statusZh) { statusZh.textContent = this.userName; }
+						if (statusEn) { statusEn.textContent = this.userName; }
+					} else {
+						if (statusZh) { statusZh.textContent = '已登录'; }
+						if (statusEn) { statusEn.textContent = 'Logged in'; }
+					}
+				} else {
+					if (statusZh) { statusZh.textContent = '已登录'; }
+					if (statusEn) { statusEn.textContent = 'Logged in'; }
+				}
+			} catch (error) {
+				console.error('Error fetching user info:', error);
+				if (statusZh) { statusZh.textContent = '已登录'; }
+				if (statusEn) { statusEn.textContent = 'Logged in'; }
+			}
+
+			// Remove loading state after fetch completes
+			this.isLoadingUserInfo = false;
+			if (startButton) {
+				startButton.disabled = false;
+				startButton.classList.remove('loading');
+			}
+			if (btnTextZh) { btnTextZh.textContent = '启动 Claude Code'; }
+			if (btnTextEn) { btnTextEn.textContent = 'Launch Claude Code'; }
+			if (arrowIcon) { arrowIcon.style.display = ''; }
+
+			if (hintZh) { hintZh.style.display = 'none'; }
+			if (hintEn) { hintEn.style.display = 'none'; }
+		} else {
+			if (statusZh) { statusZh.textContent = '未登录'; }
+			if (statusEn) { statusEn.textContent = 'Not logged in'; }
+			if (hintZh) { hintZh.style.display = this.currentLang === 'zh' ? '' : 'none'; }
+			if (hintEn) { hintEn.style.display = this.currentLang === 'en' ? '' : 'none'; }
+		}
+	}
+
+	private registerUrlHandler(): void {
+		const handler: IURLHandler = {
+			handleURL: async (uri: URI) => {
+				if (uri.scheme !== CALLBACK_SCHEME) {
+					return false;
+				}
+				if (uri.authority !== CALLBACK_AUTHORITY || uri.path !== CALLBACK_PATH) {
+					return false;
+				}
+				const params = new URLSearchParams(uri.query ?? '');
+				const token = params.get('token');
+				if (token) {
+					this.storageService.store(TOKEN_STORAGE_KEY, token, StorageScope.APPLICATION, StorageTarget.MACHINE);
+					await this.fetchAndSaveSubKey(token);
+					// Check user info and total_amount after login
+					await this.checkUserAndSubscription(token);
+					this.updateLoginStatus();
+					this.hideSplash();
+					return true;
+				}
+				return false;
+			}
+		};
+		this._register(this.urlService.registerHandler(handler));
+	}
+
+	private showInsufficientBalanceDialog(token: string): void {
+		const message = this.currentLang === 'zh'
+			? '余额不足，请充值'
+			: 'Insufficient balance, please recharge';
+		const detail = this.currentLang === 'zh'
+			? '您的账户余额不足，点击确定前往充值页面。'
+			: 'Your account balance is insufficient. Click OK to go to the recharge page.';
+
+		this.dialogService.confirm({
+			message,
+			detail,
+			primaryButton: this.currentLang === 'zh' ? '确定' : 'OK',
+			cancelButton: this.currentLang === 'zh' ? '取消' : 'Cancel'
+		}).then(result => {
+			if (result.confirmed) {
+				const subscriptionUrl = `https://deployai365.com/subscription-plans?serviceType=depcoder&instanceId=${INSTANCE_ID}&token=${encodeURIComponent(token)}&successUrl=${encodeURIComponent('vscodium://')}`;
+				this.openerService.open(URI.parse(subscriptionUrl), { openExternal: true });
+			}
+		});
+	}
+
+	private async checkUserAndSubscription(token: string): Promise<void> {
+		try {
+			const response = await fetch(USER_INFO_API, {
+				headers: {
+					'Authorization': `Bearer ${token}`
+				}
+			});
+
+			if (response.ok) {
+				const data = await response.json();
+				this.userName = data?.data?.user_name;
+				this.totalAmount = data?.data?.total_amount;
+
+				// Check if user needs to subscribe
+				if (typeof this.totalAmount === 'number' && this.totalAmount <= 0) {
+					this.showInsufficientBalanceDialog(token);
+				}
+			}
+		} catch (error) {
+			console.error('Error checking user subscription:', error);
+		}
+	}
+
+	private async fetchAndSaveSubKey(token: string): Promise<void> {
+		try {
+			const response = await fetch(API_ENDPOINT, {
+				method: 'POST',
+				headers: {
+					'Authorization': `Bearer ${token}`,
+					'Content-Type': 'application/json'
+				},
+				body: JSON.stringify({
+					instance_id: INSTANCE_ID
+				})
+			});
+
+			if (!response.ok) {
+				console.error('Failed to fetch sub key:', response.statusText);
+				return;
+			}
+
+			const data = await response.json();
+			const subKey = data?.data?.sub_key;
+			if (subKey) {
+				this.storageService.store(SUB_KEY_STORAGE_KEY, subKey, StorageScope.APPLICATION, StorageTarget.MACHINE);
+				await this.updateConfigFile(subKey);
+			}
+		} catch (error) {
+			console.error('Error fetching sub key:', error);
+		}
+	}
+
+	private async updateConfigFile(subKey: string): Promise<void> {
+		try {
+			const configPath = await this.getConfigPath();
+			let config: any = { Providers: [{ api_key: '' }] };
+
+			try {
+				const content = await this.fileService.readFile(URI.file(configPath));
+				config = JSON.parse(content.value.toString());
+			} catch (e) {
+				// File doesn't exist yet, use default config
+			}
+
+			if (!config.Providers) {
+				config.Providers = [];
+			}
+			if (!config.Providers[0]) {
+				config.Providers[0] = {};
+			}
+
+			config.Providers[0].api_key = subKey;
+
+			const content = VSBuffer.fromString(JSON.stringify(config, null, 2));
+			await this.fileService.writeFile(URI.file(configPath), content);
+			console.log('Config file updated successfully');
+
+			// Restart Claude Code Router CLI
+			await this.hostService.restartClaudeCodeRouterCli();
+		} catch (error) {
+			console.error('Error updating config file:', error);
+		}
+	}
+
+	private async getConfigPath(): Promise<string> {
+		const userHome = await this.pathService.userHome();
+		const homedir = userHome.fsPath;
+		if (isWindows) {
+			return `${homedir}\\.claude-code-router\\config.json`;
+		}
+		return `${homedir}/.claude-code-router/config.json`;
+	}
+
