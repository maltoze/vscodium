+	private setupCarousel(): void {
+		const slides = this.splashContainer?.querySelectorAll(
+			'.slide'
+		) as NodeListOf<HTMLElement>;
+		const dots = this.splashContainer?.querySelectorAll(
+			'.carousel-dot'
+		) as NodeListOf<HTMLElement>;
+
+		if (!slides || !dots) {
+			return;
+		}
+
+		const showSlide = (index: number) => {
+			slides.forEach((slide) => slide.classList.remove('active'));
+			dots.forEach((dot) => dot.classList.remove('active'));
+
+			slides[index].classList.add('active');
+			dots[index].classList.add('active');
+			this.currentSlide = index;
+		};
+
+		const nextSlide = () => {
+			this.currentSlide = (this.currentSlide + 1) % slides.length;
+			showSlide(this.currentSlide);
+		};
+
+		dots.forEach((dot, index) => {
+			this._register(
+				addDisposableListener(dot, EventType.CLICK, () => {
+					showSlide(index);
+					this.resetCarouselInterval();
+				})
+			);
+		});
+
+		this.carouselInterval = setInterval(nextSlide, 5000);
+
+		const carouselContainer = this.splashContainer?.querySelector(
+			'.carousel-container'
+		) as HTMLElement;
+		if (carouselContainer) {
+			this._register(
+				addDisposableListener(
+					carouselContainer,
+					EventType.MOUSE_ENTER,
+					() => {
+						clearInterval(this.carouselInterval);
+					}
+				)
+			);
+
+			this._register(
+				addDisposableListener(
+					carouselContainer,
+					EventType.MOUSE_LEAVE,
+					() => {
+						this.resetCarouselInterval();
+					}
+				)
+			);
+		}
+	}
+
+	private resetCarouselInterval(): void {
+		clearInterval(this.carouselInterval);
+		this.carouselInterval = setInterval(() => {
+			this.currentSlide = (this.currentSlide + 1) % 4;
+			const slides = this.splashContainer?.querySelectorAll(
+				'.slide'
+			) as NodeListOf<HTMLElement>;
+			const dots = this.splashContainer?.querySelectorAll(
+				'.carousel-dot'
+			) as NodeListOf<HTMLElement>;
+
+			slides.forEach((slide) => slide.classList.remove('active'));
+			dots.forEach((dot) => dot.classList.remove('active'));
+
+			slides[this.currentSlide].classList.add('active');
+			dots[this.currentSlide].classList.add('active');
+		}, 5000);
+	}
