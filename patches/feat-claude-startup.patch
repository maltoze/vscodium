+	private registerUrlHandler(): void {
+		const handler: IURLHandler = {
+			handleURL: async (uri: URI) => {
+				if (uri.scheme !== CALLBACK_SCHEME) {
+					return false;
+				}
+				if (
+					uri.authority !== CALLBACK_AUTHORITY ||
+					uri.path !== CALLBACK_PATH
+				) {
+					return false;
+				}
+				const params = new URLSearchParams(uri.query ?? '');
+				const token = params.get('token');
+				// zh/en
+				const lang = params.get('lang');
+
+				if (token) {
+					this.storageService.store(
+						TOKEN_STORAGE_KEY,
+						token,
+						StorageScope.APPLICATION,
+						StorageTarget.MACHINE
+					);
+					// Update login state immediately
+					this.isLoggedInContextKey.set(true);
+					// Check user info and total_amount after login
+					await this.checkUserAndSubscription(token);
+					this.updateLoginStatus();
+					this.hideSplash();
+					this.startBalanceCheck();
+				}
+				// Handle language switching if lang parameter is present
+				if (lang && (lang === 'zh' || lang === 'en')) {
+					try {
+						const targetLocale = lang === 'zh' ? 'zh-cn' : 'en';
+						const languagePackItem = {
+							id: targetLocale,
+							label: targetLocale === 'zh-cn' ? '中文' : 'English',
+							galleryExtension: undefined,
+							extensionId: undefined
+						};
+						await this.localeService.setLocale(languagePackItem, false);
+					} catch (error) {
+						console.error('Error switching language from URL:', error);
+					}
+				}
+
+				return true;
+			},
+		};
+		this._register(this.urlService.registerHandler(handler));
+	}
+
+	private showInsufficientBalanceDialog(token: string): void {
+		const successUrl = encodeURIComponent(`${CALLBACK_SCHEME}://`);
+		this.dialogService
+			.confirm({
+				message: localize2('insufficientBalance', 'Insufficient balance, please recharge').value,
+				detail: localize2('insufficientBalanceDetail', 'Your account balance is insufficient. Click OK to go to the recharge page.').value,
+				primaryButton: localize2('ok', 'OK').value,
+				cancelButton: localize2('cancel', 'Cancel').value,
+			})
+			.then((result) => {
+				if (result.confirmed) {
+					const subscriptionUrl = `https://deployai365.com/subscription-plans?serviceType=depcoder&instanceId=${INSTANCE_ID}&token=${encodeURIComponent(
+						token
+					)}&successUrl=${successUrl}`;
+					this.openerService.open(URI.parse(subscriptionUrl), {
+						openExternal: true,
+					});
+				}
+			});
+	}
+
+	private async checkUserAndSubscription(token: string): Promise<void> {
+		try {
+			const response = await fetch(USER_INFO_API, {
+				headers: {
+					Authorization: `Bearer ${token}`,
+				},
+			});
+
+			if (response.ok) {
+				const data = await response.json();
+				this.userName = data?.data?.user_name;
+				this.totalAmount = data?.data?.total_amount;
+
+				// Check if user needs to subscribe
+				if (
+					typeof this.totalAmount === 'number' &&
+					this.totalAmount <= 0.05
+				) {
+					this.showInsufficientBalanceDialog(token);
+				}
+			}
+		} catch (error) {
+			console.error('Error checking user subscription:', error);
+		}
+	}
+
+	private async fetchAndSaveSubKey(token: string): Promise<void> {
+		try {
+			const response = await fetch(API_ENDPOINT, {
+				method: 'POST',
+				headers: {
+					Authorization: `Bearer ${token}`,
+					'Content-Type': 'application/json',
+				},
+				body: JSON.stringify({
+					instance_id: INSTANCE_ID,
+				}),
+			});
+
+			if (!response.ok) {
+				console.error('Failed to fetch sub key:', response.statusText);
+				return;
+			}
+
+			const data = await response.json();
+			const subKey = data?.data?.sub_key;
+			if (subKey) {
+				this.storageService.store(
+					SUB_KEY_STORAGE_KEY,
+					subKey,
+					StorageScope.APPLICATION,
+					StorageTarget.MACHINE
+				);
+				const useCustomModel = this.storageService.getBoolean(
+					USE_CUSTOM_MODEL_KEY,
+					StorageScope.APPLICATION,
+					false
+				);
+				if (!useCustomModel) {
+					await this.updateConfigFile(subKey);
+				}
+			}
+		} catch (error) {
+			console.error('Error fetching sub key:', error);
+		}
+	}
+
+	private async updateConfigFile(subKey: string): Promise<void> {
+		try {
+			const configJson = this.storageService.get(DEPLOYAI_PROXY_CONFIG_STORAGE_KEY, StorageScope.APPLICATION);
+			let existingConfig: DeployAIProxyConfig | undefined;
+			if (configJson) {
+				try {
+					existingConfig = JSON.parse(configJson) as DeployAIProxyConfig;
+				} catch (error) {
+					console.error('Invalid DeployAI proxy config JSON, overwriting:', error);
+				}
+			}
+
+			const selectedModel = this.storageService.get(SELECTED_MODEL_KEY, StorageScope.APPLICATION) ?? 'anthropic/claude-sonnet-4.5';
+			const nextConfig: DeployAIProxyConfig = {
+				version: 1,
+				mode: existingConfig?.mode ?? 'modelproxy',
+				endpoint: existingConfig?.endpoint ?? MODELPROXY_API_ENDPOINT,
+				model: existingConfig?.model ?? selectedModel,
+				apiKey: subKey,
+				headers: existingConfig?.headers,
+				port: existingConfig?.port
+			};
+
+			this.storageService.store(
+				DEPLOYAI_PROXY_CONFIG_STORAGE_KEY,
+				JSON.stringify(nextConfig, null, 2),
+				StorageScope.APPLICATION,
+				StorageTarget.USER
+			);
+
+			this.hostService.restartClaudeCodeRouterCli();
+
+			console.log('Proxy config updated successfully');
+		} catch (error) {
+			console.error('Error updating proxy config:', error);
+		}
+	}
