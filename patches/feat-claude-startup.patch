+
+	private startBalanceCheck(): void {
+		const token = this.storageService.get(
+			TOKEN_STORAGE_KEY,
+			StorageScope.APPLICATION
+		);
+
+		if (token) {
+			// Initial fetch
+			this.fetchUserBalance(token);
+
+			// Set up interval to fetch every 10 seconds
+			this.balanceCheckInterval = setInterval(() => {
+				this.fetchUserBalance(token);
+			}, 10000);
+
+			// Clean up on dispose
+			this._register({
+				dispose: () => {
+					if (this.balanceCheckInterval) {
+						clearInterval(this.balanceCheckInterval);
+					}
+				},
+			});
+		}
+	}
+
+	private async fetchUserBalance(token: string): Promise<void> {
+		try {
+			const response = await fetch(USER_INFO_API, {
+				headers: {
+					Authorization: `Bearer ${token}`,
+				},
+			});
+
+			if (response.ok) {
+				const data = await response.json();
+				const newAmount = data?.data?.total_amount;
+				const enableCustomModel = data?.data?.enable_custom_model;
+				this.totalAmount = newAmount;
+				// Store balance in storage for other components to access
+				this.storageService.store(
+					BALANCE_STORAGE_KEY,
+					String(this.totalAmount),
+					StorageScope.APPLICATION,
+					StorageTarget.MACHINE
+				);
+				// Save enable_custom_model to storage
+				if (typeof enableCustomModel === 'boolean') {
+					this.storageService.store(
+						ENABLE_CUSTOM_MODEL_KEY,
+						String(enableCustomModel),
+						StorageScope.APPLICATION,
+						StorageTarget.MACHINE
+					);
+				}
+				// Update context key
+				if (typeof this.totalAmount === 'number') {
+					this.isLowBalanceContextKey.set(this.totalAmount <= 0.05);
+				}
+			}
+		} catch (error) {
+			console.error('Error fetching user balance:', error);
+		}
+	}
+
+	public getTotalAmount(): number | undefined {
+		return this.totalAmount;
+	}
+}
+
+// Export function to get current balance
+let currentBalanceInstance: StartupSplashContribution | undefined;
+
+export function setBalanceInstance(
+	instance: StartupSplashContribution
+): void {
+	currentBalanceInstance = instance;
+}
+
+export function getCurrentBalance(): number | undefined {
+	return currentBalanceInstance?.getTotalAmount();
+}
