@@ -0,0 +1,1317 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { IWorkbenchContribution } from '../../../common/contributions.js';
+import { IWorkbenchLayoutService } from '../../../services/layout/browser/layoutService.js';
+import {
+	IStorageService,
+	StorageScope,
+	StorageTarget,
+} from '../../../../platform/storage/common/storage.js';
+import { IOpenerService } from '../../../../platform/opener/common/opener.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import {
+	IURLHandler,
+	IURLService,
+} from '../../../../platform/url/common/url.js';
+import { URI } from '../../../../base/common/uri.js';
+import {
+	addDisposableListener,
+	EventType,
+	getWindow,
+} from '../../../../base/browser/dom.js';
+import { IFileService } from '../../../../platform/files/common/files.js';
+import { VSBuffer } from '../../../../base/common/buffer.js';
+import { IPathService } from '../../../services/path/common/pathService.js';
+import { isWindows, Language } from '../../../../base/common/platform.js';
+import { IDialogService } from '../../../../platform/dialogs/common/dialogs.js';
+import { IHostService } from '../../../services/host/browser/host.js';
+import { IContextKeyService, RawContextKey } from '../../../../platform/contextkey/common/contextkey.js';
+import { INSTANCE_ID, TOKEN_STORAGE_KEY, SUB_KEY_STORAGE_KEY, BALANCE_STORAGE_KEY, CALLBACK_SCHEME, CALLBACK_AUTHORITY, CALLBACK_PATH, USER_INFO_API, API_ENDPOINT, USE_CUSTOM_MODEL_KEY, ENABLE_CUSTOM_MODEL_KEY } from '../../../common/deployai365.js';
+import { ILocaleService } from '../../../services/localization/common/locale.js';
+import { localize2 } from '../../../../nls.js';
+
+const IsLowBalanceContext = new RawContextKey<boolean>('isLowBalance', false);
+const IsLoggedInContext = new RawContextKey<boolean>('isLoggedIn', false);
+
+const BANNER_API = 'https://launch-api.deployai365.com/api/banner/list?scene=ClaudeCodeDownload';
+
+interface BannerData {
+	id: number;
+	title_zh: string;
+	title_en: string;
+	description_zh: string;
+	description_en: string;
+	image: string;
+	link_url?: string;
+	sort_order: number;
+	status: string;
+}
+
+export class StartupSplashContribution
+	extends Disposable
+	implements IWorkbenchContribution {
+	static readonly ID = 'workbench.contrib.startupSplash';
+
+	private splashContainer: HTMLElement | undefined;
+	private currentSlide = 0;
+	private carouselInterval: any;
+	private balanceCheckInterval: any;
+	private userName: string | undefined;
+	private totalAmount: number | undefined;
+	private isLoadingUserInfo = false;
+	private currentLanguage: 'zh' | 'en' = 'en';
+	private isLowBalanceContextKey: ReturnType<typeof IsLowBalanceContext.bindTo>;
+	private isLoggedInContextKey: ReturnType<typeof IsLoggedInContext.bindTo>;
+	private slidesData: BannerData[] = [];
+	private defaultSlides = [
+		{
+			id: 1,
+			imageUrl: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&h=250&q=80',
+			titleZh: '智能代码补全',
+			titleEn: 'Intelligent Code Completion',
+			textZh: '通过先进的 AI 模型，Claude Code 能够理解您的代码上下文，提供精准的代码建议',
+			textEn: 'Using advanced AI models, Claude Code understands your code context and provides precise code suggestions',
+			linkUrl: undefined,
+		},
+		{
+			id: 2,
+			imageUrl: 'https://images.unsplash.com/photo-1552308995-2baac1ad5490?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&h=250&q=80',
+			titleZh: '实时协作',
+			titleEn: 'Real-time Collaboration',
+			textZh: '与团队成员无缝协作，共享代码、注释和想法，提高开发效率',
+			textEn: 'Seamlessly collaborate with team members, share code, comments and ideas to improve development efficiency',
+			linkUrl: undefined,
+		},
+		{
+			id: 3,
+			imageUrl: 'https://images.unsplash.com/photo-1542831371-29b0f74f9713?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&h=250&q=80',
+			titleZh: '代码分析与优化',
+			titleEn: 'Code Analysis & Optimization',
+			textZh: '自动检测潜在问题并提供改进建议，让您的代码更高效、更安全',
+			textEn: 'Automatically detect potential issues and provide improvement suggestions to make your code more efficient and secure',
+			linkUrl: undefined,
+		},
+		{
+			id: 4,
+			imageUrl: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&h=250&q=80',
+			titleZh: '多语言支持',
+			titleEn: 'Multi-language Support',
+			textZh: '支持 Python、JavaScript、Java、C++ 等多种主流编程语言，满足不同开发需求',
+			textEn: 'Supports Python, JavaScript, Java, C++ and other mainstream programming languages to meet various development needs',
+			linkUrl: undefined,
+		},
+	];
+
+	constructor(
+		@IWorkbenchLayoutService
+		private readonly layoutService: IWorkbenchLayoutService,
+		@IStorageService private readonly storageService: IStorageService,
+		@IOpenerService private readonly openerService: IOpenerService,
+		@IURLService private readonly urlService: IURLService,
+		@IFileService private readonly fileService: IFileService,
+		@IPathService private readonly pathService: IPathService,
+		@IDialogService private readonly dialogService: IDialogService,
+		@IHostService private readonly hostService: IHostService,
+		@IContextKeyService contextKeyService: IContextKeyService,
+		@ILocaleService private readonly localeService: ILocaleService
+	) {
+		super();
+		this.isLowBalanceContextKey = IsLowBalanceContext.bindTo(contextKeyService);
+		this.isLoggedInContextKey = IsLoggedInContext.bindTo(contextKeyService);
+		// Check initial login state
+		const token = this.storageService.get(TOKEN_STORAGE_KEY, StorageScope.APPLICATION);
+		this.isLoggedInContextKey.set(!!token);
+		this.init();
+	}
+
+	private async init(): Promise<void> {
+		this.initializeLanguage();
+		this.registerUrlHandler();
+
+		// Check if user is logged in and has sufficient balance
+		const token = this.storageService.get(TOKEN_STORAGE_KEY, StorageScope.APPLICATION);
+		if (token) {
+			// Fetch user info first
+			const userInfo = await this.fetchUserInfo(token);
+
+			// If user has sufficient balance (> 0), skip splash screen
+			if (userInfo && typeof userInfo.totalAmount === 'number' && userInfo.totalAmount > 0) {
+				this.userName = userInfo.userName;
+				this.totalAmount = userInfo.totalAmount;
+				await this.fetchAndSaveSubKey(token);
+				this.hostService.restartClaudeCodeRouterCli();
+				this.startBalanceCheck();
+				return;
+			}
+		}
+
+		// Show splash immediately, then load banner data
+		this.showSplash();
+		// Fetch banner data asynchronously and update carousel
+		this.fetchBannerData().then(() => {
+			this.updateCarouselWithBannerData();
+		});
+		this.hostService.restartClaudeCodeRouterCli();
+		this.startBalanceCheck();
+	}
+
+	private initializeLanguage(): void {
+		// Get current language from VSCode
+		const currentLocale = Language.value() || 'en';
+		this.currentLanguage = currentLocale.startsWith('zh') ? 'zh' : 'en';
+	}
+
+	private async fetchUserInfo(token: string): Promise<{ userName?: string; totalAmount?: number; enableCustomModel?: boolean } | null> {
+		try {
+			const response = await fetch(USER_INFO_API, {
+				headers: {
+					Authorization: `Bearer ${token}`,
+				},
+			});
+
+			if (response.status === 401) {
+				// Token invalid, remove it
+				this.storageService.remove(TOKEN_STORAGE_KEY, StorageScope.APPLICATION);
+				return null;
+			}
+
+			if (response.ok) {
+				const data = await response.json();
+				const userName = data?.data?.user_name;
+				const totalAmount = data?.data?.total_amount;
+				const enableCustomModel = data?.data?.enable_custom_model;
+
+				// Save enable_custom_model to storage
+				if (typeof enableCustomModel === 'boolean') {
+					this.storageService.store(
+						ENABLE_CUSTOM_MODEL_KEY,
+						String(enableCustomModel),
+						StorageScope.APPLICATION,
+						StorageTarget.MACHINE
+					);
+				}
+
+				return { userName, totalAmount, enableCustomModel };
+			}
+		} catch (error) {
+			console.error('Error fetching user info:', error);
+		}
+		return null;
+	}
+
+	private async fetchBannerData(): Promise<void> {
+		try {
+			const response = await fetch(BANNER_API);
+			if (response.ok) {
+				const result = await response.json();
+				if (result.code === 20000 && Array.isArray(result.data)) {
+					// Filter active banners and sort by sort_order
+					this.slidesData = result.data
+						.filter((banner: BannerData) => banner.status === 'active')
+						.sort((a: BannerData, b: BannerData) => a.sort_order - b.sort_order);
+				}
+			}
+		} catch (error) {
+			console.error('Error fetching banner data:', error);
+			// Keep slidesData empty to use default slides
+		}
+	}
+
+	private showSplash(): void {
+		this.splashContainer = document.createElement('div');
+		this.splashContainer.className = 'startup-splash-container';
+
+		// Star background
+		const starField = document.createElement('div');
+		starField.className = 'star-field';
+		starField.id = 'starField';
+		this.splashContainer.appendChild(starField);
+
+		// Language switcher
+		const langSwitch = document.createElement('div');
+		langSwitch.className = 'lang-switch';
+		const langBtn = document.createElement('button');
+		langBtn.id = 'langSwitch';
+		langBtn.className = 'lang-switch-btn';
+		const globeIcon = document.createElement('span');
+		globeIcon.className = 'codicon codicon-globe';
+		const langDisplay = document.createElement('span');
+		langDisplay.id = 'langDisplay';
+		langDisplay.className = 'lang-display';
+		langDisplay.textContent = this.currentLanguage === 'zh' ? '中文' : 'English';
+		langBtn.title = localize2('toggleLanguage', 'Toggle Language').value;
+		langBtn.appendChild(globeIcon);
+		langBtn.appendChild(langDisplay);
+		langSwitch.appendChild(langBtn);
+		this.splashContainer.appendChild(langSwitch);
+
+		// Main content
+		const splashContent = document.createElement('div');
+		splashContent.className = 'splash-content';
+
+		// Logo
+		const logoContainer = document.createElement('div');
+		logoContainer.className = 'logo-container';
+		const logoBox = document.createElement('div');
+		logoBox.className = 'logo-box';
+		const logoIcon = document.createElement('span');
+		logoIcon.className = `logo-icon codicon codicon-${Codicon.code.id}`;
+		logoBox.appendChild(logoIcon);
+		logoContainer.appendChild(logoBox);
+		splashContent.appendChild(logoContainer);
+
+		// Carousel
+		const carouselContainer = document.createElement('div');
+		carouselContainer.className = 'carousel-container';
+
+		// Use API data if available, otherwise use default slides
+		const slides = this.slidesData.length > 0
+			? this.slidesData.map(banner => ({
+				imageUrl: banner.image,
+				titleZh: banner.title_zh,
+				titleEn: banner.title_en,
+				textZh: banner.description_zh,
+				textEn: banner.description_en,
+				linkUrl: banner.link_url,
+			}))
+			: this.defaultSlides;
+
+		slides.forEach((slideData, index) => {
+			const slide = document.createElement('div');
+			slide.className = index === 0 ? 'slide active' : 'slide';
+
+			const img = document.createElement('img');
+			img.src = slideData.imageUrl;
+			img.alt = slideData.titleEn;
+			img.className = 'slide-image';
+			slide.appendChild(img);
+
+			const title = document.createElement('h2');
+			title.className = 'slide-title';
+			title.textContent = this.currentLanguage === 'zh' ? slideData.titleZh : slideData.titleEn;
+			slide.appendChild(title);
+
+			const text = document.createElement('p');
+			text.className = 'slide-text';
+			text.textContent = this.currentLanguage === 'zh' ? slideData.textZh : slideData.textEn;
+			slide.appendChild(text);
+
+			// Add click handler if linkUrl exists
+			if (slideData.linkUrl) {
+				slide.style.cursor = 'pointer';
+				this._register(
+					addDisposableListener(slide, EventType.CLICK, () => {
+						if (slideData.linkUrl) {
+							this.openerService.open(URI.parse(slideData.linkUrl), { openExternal: true });
+						}
+					})
+				);
+			}
+
+			carouselContainer.appendChild(slide);
+		});
+
+		splashContent.appendChild(carouselContainer);
+
+		// Carousel dots
+		const carouselDots = document.createElement('div');
+		carouselDots.className = 'carousel-dots';
+		for (let i = 0; i < slides.length; i++) {
+			const dot = document.createElement('button');
+			dot.className = i === 0 ? 'carousel-dot active' : 'carousel-dot';
+			dot.setAttribute('data-slide', String(i));
+			carouselDots.appendChild(dot);
+		}
+		splashContent.appendChild(carouselDots);
+
+		// Start button
+		const startButton = document.createElement('button');
+		startButton.id = 'startButton';
+		startButton.className = 'start-button';
+		const btnText = document.createElement('span');
+		btnText.className = 'button-text';
+		btnText.textContent = localize2('launchClaudeCode', 'Launch Claude Code').value;
+		const arrowIcon = document.createElement('span');
+		arrowIcon.className = 'arrow-icon';
+		arrowIcon.textContent = '→';
+		startButton.appendChild(btnText);
+		startButton.appendChild(arrowIcon);
+
+		// Initialize button state based on token
+		const token = this.storageService.get(
+			TOKEN_STORAGE_KEY,
+			StorageScope.APPLICATION
+		);
+		if (token) {
+			// If has token, set loading state initially
+			this.isLoadingUserInfo = true;
