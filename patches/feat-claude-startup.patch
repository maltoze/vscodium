+ *--------------------------------------------------------------------------------------------*/
+
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { IWorkbenchContribution } from '../../../common/contributions.js';
+import { IWorkbenchLayoutService } from '../../../services/layout/browser/layoutService.js';
+import { IStorageService, StorageScope, StorageTarget } from '../../../../platform/storage/common/storage.js';
+import { addDisposableListener, EventType, getWindow } from '../../../../base/browser/dom.js';
+
+const LANGUAGE_STORAGE_KEY = 'workbench.startupSplash.language';
+
+export class StartupSplashContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.startupSplash';
+
+	private splashContainer: HTMLElement | undefined;
+	private currentLang = 'zh';
+	private currentSlide = 0;
+	private carouselInterval: any;
+
+	constructor(
+		@IWorkbenchLayoutService private readonly layoutService: IWorkbenchLayoutService,
+		@IStorageService private readonly storageService: IStorageService,
+	) {
+		super();
+		this.init();
+	}
+
+	private async init(): Promise<void> {
+		const savedLanguage = this.storageService.get(LANGUAGE_STORAGE_KEY, StorageScope.APPLICATION);
+		this.currentLang = savedLanguage || 'zh';
+
+		this.showSplash();
+	}
+
+	private showSplash(): void {
+		this.splashContainer = document.createElement('div');
+		this.splashContainer.className = 'startup-splash-container';
+
+		// Star background
+		const starField = document.createElement('div');
+		starField.className = 'star-field';
+		starField.id = 'starField';
+		this.splashContainer.appendChild(starField);
+
+		// Language switcher
+		const langSwitch = document.createElement('div');
+		langSwitch.className = 'lang-switch';
+		const langBtn = document.createElement('button');
+		langBtn.id = 'langSwitch';
+		langBtn.className = 'lang-switch-btn';
+		const globeIcon = document.createElement('span');
+		globeIcon.className = 'globe-icon';
+		globeIcon.textContent = '🌐';
+		const langDisplay = document.createElement('span');
+		langDisplay.id = 'langDisplay';
+		langDisplay.textContent = this.currentLang === 'zh' ? '中文' : 'English';
+		langBtn.appendChild(globeIcon);
+		langBtn.appendChild(langDisplay);
+		langSwitch.appendChild(langBtn);
+		this.splashContainer.appendChild(langSwitch);
+
+		// Main content
+		const splashContent = document.createElement('div');
+		splashContent.className = 'splash-content';
+
+		// Logo
+		const logoContainer = document.createElement('div');
+		logoContainer.className = 'logo-container';
+		const logoBox = document.createElement('div');
+		logoBox.className = 'logo-box';
+		const logoIcon = document.createElement('span');
+		logoIcon.className = 'logo-icon';
+		logoIcon.textContent = '⚡';
+		logoBox.appendChild(logoIcon);
+		logoContainer.appendChild(logoBox);
+		splashContent.appendChild(logoContainer);
+
+		// Carousel
+		const carouselContainer = document.createElement('div');
+		carouselContainer.className = 'carousel-container';
+
+		const slides = [
+			{ imageUrl: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&h=250&q=80', titleZh: '智能代码补全', titleEn: 'Intelligent Code Completion', textZh: '通过先进的 AI 模型，Claude Code 能够理解您的代码上下文，提供精准的代码建议', textEn: 'Using advanced AI models, Claude Code understands your code context and provides precise code suggestions' },
+			{ imageUrl: 'https://images.unsplash.com/photo-1552308995-2baac1ad5490?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&h=250&q=80', titleZh: '实时协作', titleEn: 'Real-time Collaboration', textZh: '与团队成员无缝协作，共享代码、注释和想法，提高开发效率', textEn: 'Seamlessly collaborate with team members, share code, comments and ideas to improve development efficiency' },
+			{ imageUrl: 'https://images.unsplash.com/photo-1542831371-29b0f74f9713?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&h=250&q=80', titleZh: '代码分析与优化', titleEn: 'Code Analysis & Optimization', textZh: '自动检测潜在问题并提供改进建议，让您的代码更高效、更安全', textEn: 'Automatically detect potential issues and provide improvement suggestions to make your code more efficient and secure' },
+			{ imageUrl: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&h=250&q=80', titleZh: '多语言支持', titleEn: 'Multi-language Support', textZh: '支持 Python、JavaScript、Java、C++ 等多种主流编程语言，满足不同开发需求', textEn: 'Supports Python, JavaScript, Java, C++ and other mainstream programming languages to meet various development needs' }
+		];
+
+		slides.forEach((slideData, index) => {
+			const slide = document.createElement('div');
+			slide.className = index === 0 ? 'slide active' : 'slide';
+
+			const img = document.createElement('img');
+			img.src = slideData.imageUrl;
+			img.alt = slideData.titleEn;
+			img.className = 'slide-image';
+			slide.appendChild(img);
+
+			const titleZh = document.createElement('h2');
+			titleZh.className = 'slide-title lang-zh';
+			titleZh.textContent = slideData.titleZh;
+			slide.appendChild(titleZh);
+
+			const titleEn = document.createElement('h2');
+			titleEn.className = 'slide-title lang-en';
+			titleEn.style.display = 'none';
+			titleEn.textContent = slideData.titleEn;
+			slide.appendChild(titleEn);
+
+			const textZh = document.createElement('p');
+			textZh.className = 'slide-text lang-zh';
+			textZh.textContent = slideData.textZh;
+			slide.appendChild(textZh);
+
+			const textEn = document.createElement('p');
+			textEn.className = 'slide-text lang-en';
+			textEn.style.display = 'none';
+			textEn.textContent = slideData.textEn;
+			slide.appendChild(textEn);
+
+			carouselContainer.appendChild(slide);
+		});
+
+		splashContent.appendChild(carouselContainer);
+
+		// Carousel dots
+		const carouselDots = document.createElement('div');
+		carouselDots.className = 'carousel-dots';
+		for (let i = 0; i < 4; i++) {
+			const dot = document.createElement('button');
+			dot.className = i === 0 ? 'carousel-dot active' : 'carousel-dot';
+			dot.setAttribute('data-slide', String(i));
+			carouselDots.appendChild(dot);
+		}
+		splashContent.appendChild(carouselDots);
+
+		// Start button
+		const startButton = document.createElement('button');
+		startButton.id = 'startButton';
+		startButton.className = 'start-button';
+		const btnTextZh = document.createElement('span');
+		btnTextZh.className = 'lang-zh';
+		btnTextZh.textContent = '启动 Claude Code';
+		const btnTextEn = document.createElement('span');
+		btnTextEn.className = 'lang-en';
+		btnTextEn.style.display = 'none';
+		btnTextEn.textContent = 'Launch Claude Code';
+		const arrowIcon = document.createElement('span');
+		arrowIcon.className = 'arrow-icon';
+		arrowIcon.textContent = '→';
+		startButton.appendChild(btnTextZh);
+		startButton.appendChild(btnTextEn);
+		startButton.appendChild(arrowIcon);
+		splashContent.appendChild(startButton);
+
+		// Status info
+		const statusInfo = document.createElement('div');
+		statusInfo.className = 'status-info';
+		const loginStatus = document.createElement('div');
+		loginStatus.id = 'loginStatus';
+		loginStatus.className = 'login-status';
+		const userIcon = document.createElement('span');
+		userIcon.className = 'user-icon';
+		userIcon.textContent = '👤';
+		const statusTextZh = document.createElement('span');
+		statusTextZh.className = 'lang-zh';
+		statusTextZh.textContent = '未登录';
+		const statusTextEn = document.createElement('span');
+		statusTextEn.className = 'lang-en';
+		statusTextEn.style.display = 'none';
+		statusTextEn.textContent = 'Not logged in';
+		const hintZh = document.createElement('span');
+		hintZh.className = 'login-hint lang-zh';
+		hintZh.textContent = '(点击登录)';
+		const hintEn = document.createElement('span');
+		hintEn.className = 'login-hint lang-en';
+		hintEn.style.display = 'none';
+		hintEn.textContent = '(Click to login)';
+		loginStatus.appendChild(userIcon);
+		loginStatus.appendChild(statusTextZh);
+		loginStatus.appendChild(statusTextEn);
+		loginStatus.appendChild(hintZh);
+		loginStatus.appendChild(hintEn);
+		statusInfo.appendChild(loginStatus);
+		splashContent.appendChild(statusInfo);
+
+		// Version info
+		const versionInfo = document.createElement('div');
+		versionInfo.className = 'version-info';
+		const version = document.createElement('span');
+		version.textContent = 'Version 1.0.1';
+		const dot = document.createElement('span');
+		dot.className = 'dot';
+		const copyright = document.createElement('span');
+		copyright.textContent = '© 2025 Anthropic';
+		versionInfo.appendChild(version);
+		versionInfo.appendChild(dot);
+		versionInfo.appendChild(copyright);
+		splashContent.appendChild(versionInfo);
+
+		this.splashContainer.appendChild(splashContent);
+
+		const mainContainer = this.layoutService.mainContainer;
+		mainContainer.appendChild(this.splashContainer);
+
+		this.applyStyles();
+		this.createStars();
+		this.addEventListeners();
+		this.setupCarousel();
+	}
+
+	private createStars(): void {
+		const starField = this.splashContainer?.querySelector('#starField') as HTMLElement;
+		if (!starField) {
+			return;
+		}
+
+		const starCount = 150;
+		for (let i = 0; i < starCount; i++) {
+			const star = document.createElement('div');
+			star.className = 'star';
+
+			const size = Math.random() * 2;
+			star.style.width = `${size}px`;
+			star.style.height = `${size}px`;
+
+			const x = Math.random() * 100;
+			const y = Math.random() * 100;
+			star.style.left = `${x}%`;
+			star.style.top = `${y}%`;
+
+			star.style.opacity = String(Math.random() * 0.7 + 0.3);
+
+			const duration = 3 + Math.random() * 7;
+			star.style.animation = `pulse ${duration}s infinite`;
+
+			starField.appendChild(star);
+		}
+	}
+
+	private setupCarousel(): void {
+		const slides = this.splashContainer?.querySelectorAll('.slide') as NodeListOf<HTMLElement>;
+		const dots = this.splashContainer?.querySelectorAll('.carousel-dot') as NodeListOf<HTMLElement>;
+
+		if (!slides || !dots) {
+			return;
+		}
+
+		const showSlide = (index: number) => {
+			slides.forEach(slide => slide.classList.remove('active'));
+			dots.forEach(dot => dot.classList.remove('active'));
+
+			slides[index].classList.add('active');
+			dots[index].classList.add('active');
+			this.currentSlide = index;
+		};
+
+		const nextSlide = () => {
+			this.currentSlide = (this.currentSlide + 1) % slides.length;
+			showSlide(this.currentSlide);
+		};
+
+		dots.forEach((dot, index) => {
+			this._register(addDisposableListener(dot, EventType.CLICK, () => {
+				showSlide(index);
+				this.resetCarouselInterval();
+			}));
+		});
+
+		this.carouselInterval = setInterval(nextSlide, 5000);
+
+		const carouselContainer = this.splashContainer?.querySelector('.carousel-container') as HTMLElement;
+		if (carouselContainer) {
+			this._register(addDisposableListener(carouselContainer, EventType.MOUSE_ENTER, () => {
+				clearInterval(this.carouselInterval);
+			}));
+
+			this._register(addDisposableListener(carouselContainer, EventType.MOUSE_LEAVE, () => {
+				this.resetCarouselInterval();
+			}));
+		}
+	}
+
+	private resetCarouselInterval(): void {
+		clearInterval(this.carouselInterval);
+		this.carouselInterval = setInterval(() => {
+			this.currentSlide = (this.currentSlide + 1) % 4;
+			const slides = this.splashContainer?.querySelectorAll('.slide') as NodeListOf<HTMLElement>;
+			const dots = this.splashContainer?.querySelectorAll('.carousel-dot') as NodeListOf<HTMLElement>;
+
+			slides.forEach(slide => slide.classList.remove('active'));
+			dots.forEach(dot => dot.classList.remove('active'));
+
+			slides[this.currentSlide].classList.add('active');
+			dots[this.currentSlide].classList.add('active');
+		}, 5000);
+	}
+
+	private addEventListeners(): void {
+		if (!this.splashContainer) {
+			return;
+		}
+
+		const langSwitch = this.splashContainer.querySelector('#langSwitch') as HTMLElement;
+		if (langSwitch) {
+			this._register(addDisposableListener(langSwitch, EventType.CLICK, () => {
+				this.toggleLanguage();
+			}));
+		}
+
+		const startButton = this.splashContainer.querySelector('#startButton') as HTMLElement;
+		if (startButton) {
+			this._register(addDisposableListener(startButton, EventType.CLICK, () => {
+				this.handleStartButtonClick();
+			}));
+		}
+
+		const targetWindow = getWindow(this.splashContainer);
+		this._register(addDisposableListener(targetWindow.document, EventType.KEY_DOWN, (e: KeyboardEvent) => {
+			if (e.key === 'Enter' || e.key === ' ') {
+				e.preventDefault();
+				this.handleStartButtonClick();
+			}
+		}));
+	}
+
+	private toggleLanguage(): void {
+		this.currentLang = this.currentLang === 'zh' ? 'en' : 'zh';
+
+		this.storageService.store(LANGUAGE_STORAGE_KEY, this.currentLang, StorageScope.APPLICATION, StorageTarget.MACHINE);
+
+		const langDisplay = this.splashContainer?.querySelector('#langDisplay') as HTMLElement;
+		if (langDisplay) {
+			langDisplay.textContent = this.currentLang === 'zh' ? '中文' : 'English';
+		}
+
+		const zhElements = this.splashContainer?.querySelectorAll('.lang-zh') as NodeListOf<HTMLElement>;
+		const enElements = this.splashContainer?.querySelectorAll('.lang-en') as NodeListOf<HTMLElement>;
+
+		if (this.currentLang === 'zh') {
+			zhElements.forEach(el => el.style.display = '');
+			enElements.forEach(el => el.style.display = 'none');
+		} else {
+			zhElements.forEach(el => el.style.display = 'none');
+			enElements.forEach(el => el.style.display = '');
+		}
+	}
+
+	private handleStartButtonClick(): void {
+		this.hideSplash();
+	}
+
+	private hideSplash(): void {
+		if (!this.splashContainer) {
+			return;
+		}
+
+		clearInterval(this.carouselInterval);
+
+		this.splashContainer.style.opacity = '0';
+		this.splashContainer.style.transition = 'opacity 0.3s ease-out';
+
+		setTimeout(() => {
+			if (this.splashContainer && this.splashContainer.parentNode) {
+				this.splashContainer.parentNode.removeChild(this.splashContainer);
+			}
+			this.splashContainer = undefined;
+		}, 300);
+	}
+
+	private applyStyles(): void {
+		if (!this.splashContainer) {
+			return;
+		}
+
+		this.addGlobalStyles();
+
+		Object.assign(this.splashContainer.style, {
+			position: 'fixed',
+			top: '0',
+			left: '0',
+			width: '100%',
+			height: '100%',
+			backgroundColor: '#000',
+			color: '#fff',
+			fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
+			zIndex: '10000',
+			opacity: '1',
+			overflow: 'hidden'
+		});
+	}
+
+	private addGlobalStyles(): void {
+		if (!this.splashContainer) {
+			return;
+		}
+
+		const targetWindow = getWindow(this.splashContainer);
+
+		if (targetWindow.document.getElementById('startup-splash-styles')) {
+			return;
+		}
+
+		const style = targetWindow.document.createElement('style');
+		style.id = 'startup-splash-styles';
+		style.textContent = `
+			@keyframes float {
+				0% { transform: translateY(0px); }
+				50% { transform: translateY(-10px); }
+				100% { transform: translateY(0px); }
+			}
+
+			@keyframes pulse {
+				0% { opacity: 0.8; }
+				50% { opacity: 1; }
+				100% { opacity: 0.8; }
+			}
+
+			@keyframes gradientAnimation {
+				0% { background-position: 0% 50%; }
+				50% { background-position: 100% 50%; }
+				100% { background-position: 0% 50%; }
+			}
+
+			.startup-splash-container {
+				background: linear-gradient(120deg, #000000, #0a0a0a, #000000);
+				background-size: 300% 300%;
+				animation: gradientAnimation 15s ease infinite;
+			}
+
+			.star-field {
+				position: absolute;
+				top: 0;
+				left: 0;
+				width: 100%;
+				height: 100%;
+				overflow: hidden;
+				z-index: 0;
+			}
+
+			.star {
+				position: absolute;
+				background-color: rgba(255, 255, 255, 0.6);
+				border-radius: 50%;
+			}
+
+			.lang-switch {
+				position: absolute;
+				top: 20px;
+				right: 20px;
+				z-index: 20;
+			}
+
+			.lang-switch-btn {
+				padding: 8px 12px;
+				border-radius: 9999px;
+				background-color: #1f2937;
+				color: #d1d5db;
+				border: none;
+				cursor: pointer;
+				transition: background-color 0.2s;
+				font-size: 14px;
+				display: flex;
+				align-items: center;
+				gap: 4px;
+			}
+
+			.lang-switch-btn:hover {
+				background-color: #374151;
+			}
+
+			.splash-content {
+				position: relative;
+				z-index: 10;
+				min-height: 100vh;
+				display: flex;
+				flex-direction: column;
+				justify-content: center;
+				align-items: center;
+				padding: 32px 16px;
+			}
+
+			.logo-container {
+				margin-bottom: 32px;
+				animation: float 6s ease-in-out infinite;
+			}
+
+			.logo-box {
+				width: 96px;
+				height: 96px;
+				border-radius: 16px;
+				background: linear-gradient(to bottom right, #D97757, #c06548);
+				display: flex;
+				align-items: center;
+				justify-content: center;
+				font-size: 48px;
+				box-shadow: 0 10px 25px rgba(217, 119, 87, 0.3);
+			}
+
+			.carousel-container {
+				width: 100%;
+				max-width: 768px;
+				margin: 0 auto 48px;
+				position: relative;
+				height: 320px;
