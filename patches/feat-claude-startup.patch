+	private async setTheme(themeType: 'light' | 'dark'): Promise<void> {
+		try {
+			// Get all available themes
+			const themes = await this.workbenchThemeService.getColorThemes();
+
+			// Find the default theme based on type
+			const targetSettingsId = themeType === 'light' ? ThemeSettingDefaults.COLOR_THEME_LIGHT : ThemeSettingDefaults.COLOR_THEME_DARK;
+			const theme = themes.find(t => t.settingsId === targetSettingsId);
+
+			if (theme) {
+				await this.workbenchThemeService.setColorTheme(theme.id, 'auto');
+			} else {
+				console.warn(`Theme not found: ${targetSettingsId}`);
+			}
+		} catch (error) {
+			console.error('Error setting theme:', error);
+		}
+	}
