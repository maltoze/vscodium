+	private triggerLoginIfNeeded(): void {
+		const token = this.storageService.get(
+			TOKEN_STORAGE_KEY,
+			StorageScope.APPLICATION
+		);
+		if (token) {
+			this.updateLoginStatus();
+			return;
+		}
+		const callback = URI.from({
+			scheme: CALLBACK_SCHEME,
+			authority: CALLBACK_AUTHORITY,
+			path: CALLBACK_PATH,
+		});
+		const loginUrl = `https://login.deployai365.com/?platform=cline&originUrl=${encodeURIComponent(
+			callback.toString()
+		)}`;
+		this.openerService.open(URI.parse(loginUrl), { openExternal: true });
+	}
