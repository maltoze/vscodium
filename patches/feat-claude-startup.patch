+	async restartClaudeCodeRouterCli(): Promise<void> {
+		await this.applicationStorageMainService.whenReady;
+
+		const configJson = this.applicationStorageMainService.get(DEPLOYAI_PROXY_CONFIG_STORAGE_KEY, StorageScope.APPLICATION);
+		if (!configJson) {
+			this.logService.warn('DeployAI proxy config is not set. Skipping proxy restart.');
+			return;
+		}
+
+		let config: DeployAIProxyConfig;
+		try {
+			config = JSON.parse(configJson) as DeployAIProxyConfig;
+		} catch (error) {
+			this.logService.error('DeployAI proxy config is invalid JSON:', error);
+			return;
+		}
+
+		try {
+			const preferredPort = config.port ?? DEFAULT_DEPLOYAI_PROXY_PORT;
+			const actualPort = await this.deployAIProxyServer.start(config, preferredPort);
+
+			if (actualPort !== config.port) {
+				const updatedConfig: DeployAIProxyConfig = { ...config, port: actualPort };
+				this.applicationStorageMainService.store(
+					DEPLOYAI_PROXY_CONFIG_STORAGE_KEY,
+					JSON.stringify(updatedConfig),
+					StorageScope.APPLICATION,
+					StorageTarget.USER
+				);
+			}
+		} catch (error) {
+			this.logService.error('Failed to start DeployAI proxy server:', error);
+			Sentry.captureException(error);
+		}
+	}
+
+	async readClaudeCodeRouterConfig(_windowId: number | undefined): Promise<string | undefined> {
+		await this.applicationStorageMainService.whenReady;
+		return this.applicationStorageMainService.get(DEPLOYAI_PROXY_CONFIG_STORAGE_KEY, StorageScope.APPLICATION);
+	}
+
+	async writeClaudeCodeRouterConfig(_windowId: number | undefined, configJson: string): Promise<void> {
+		await this.applicationStorageMainService.whenReady;
+		this.applicationStorageMainService.store(DEPLOYAI_PROXY_CONFIG_STORAGE_KEY, configJson, StorageScope.APPLICATION, StorageTarget.USER);
+		await this.restartClaudeCodeRouterCli();
+	}
 }
