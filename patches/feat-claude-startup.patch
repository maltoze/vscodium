diff --git a/src/vs/platform/deployai/electron-main/deployAIProxyServer.ts b/src/vs/platform/deployai/electron-main/deployAIProxyServer.ts
new file mode 100644
index 0000000..87302f7
--- /dev/null
+++ b/src/vs/platform/deployai/electron-main/deployAIProxyServer.ts
@@ -0,0 +1,650 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { createServer, IncomingMessage, request as httpRequest, ServerResponse } from 'http';
+import { request as httpsRequest } from 'https';
+import { pipeline as pipelineCallback } from 'stream';
+import { URL } from 'url';
+import { promisify } from 'util';
+import { Disposable } from '../../../base/common/lifecycle.js';
+import { findFreePort } from '../../../base/node/ports.js';
+import { ILogService } from '../../log/common/log.js';
+import { DeployAIProxyConfig } from '../common/deployaiProxyConfig.js';
+
+const DEFAULT_PORT_SCAN_RETRIES = 25;
+const DEFAULT_PORT_SCAN_TIMEOUT_MS = 2000;
+
+const pipeline = promisify(pipelineCallback);
+
+export class DeployAIProxyServer extends Disposable {
+	private server: ReturnType<typeof createServer> | undefined;
+	private activePort: number | undefined;
+
+	constructor(
+		@ILogService private readonly logService: ILogService
+	) {
+		super();
+	}
+
+	get port(): number | undefined {
+		return this.activePort;
+	}
+
+	async start(config: DeployAIProxyConfig, preferredPort: number): Promise<number> {
+		await this.stop();
+
+		const endpoint = config.endpoint?.trim();
+		if (!endpoint) {
+			throw new Error('DeployAI proxy endpoint is missing');
+		}
+
+		const port = await this.resolvePort(preferredPort);
+		this.server = createServer((req, res) => {
+			this.handleRequest(req, res, config).catch(error => {
+				this.logService.error('DeployAI proxy request failed:', error);
+				if (!res.headersSent) {
+					res.statusCode = 502;
+				}
+				res.end();
+			});
+		});
+
+		await new Promise<void>((resolve, reject) => {
+			this.server!.once('error', reject);
+			this.server!.listen(port, '127.0.0.1', () => resolve());
+		});
+
+		this.activePort = port;
+		this.logService.info(`DeployAI proxy server listening on 127.0.0.1:${port}`);
+		return port;
+	}
+
+	async stop(): Promise<void> {
+		if (!this.server) {
+			return;
+		}
+
+		const server = this.server;
+		this.server = undefined;
+		this.activePort = undefined;
+
+		await new Promise<void>((resolve) => server.close(() => resolve()));
+	}
+
+	private async resolvePort(preferredPort: number): Promise<number> {
+		if (preferredPort <= 0) {
+			throw new Error('Preferred port must be greater than 0');
+		}
+
+		const port = await findFreePort(preferredPort, DEFAULT_PORT_SCAN_RETRIES, DEFAULT_PORT_SCAN_TIMEOUT_MS);
+		if (port > 0) {
+			return port;
+		}
+
+		throw new Error('Unable to find a free port for DeployAI proxy server');
+	}
+
+	private async handleRequest(req: IncomingMessage, res: ServerResponse, config: DeployAIProxyConfig): Promise<void> {
+		const incomingUrl = new URL(req.url ?? '/', 'http://localhost');
+		if (incomingUrl.pathname.startsWith('/v1/messages/count_tokens')) {
+			const bodyBuffer = await this.readRequestBody(req);
+			const payload = this.parseJson(bodyBuffer.toString('utf-8'));
+			const inputTokens = this.estimateClaudeTokens(payload);
+			const responseBody = Buffer.from(JSON.stringify({ input_tokens: inputTokens }));
+			res.writeHead(200, {
+				'content-type': 'application/json',
+				'content-length': String(responseBody.length)
+			});
+			res.end(responseBody);
+			return;
+		}
+
+		const isClaudeMessages = incomingUrl.pathname.startsWith('/v1/messages');
+		const targetPath = isClaudeMessages ? '/v1/chat/completions' : `${incomingUrl.pathname}${incomingUrl.search}`;
+		const targetUrl = this.resolveTargetUrl(config.endpoint, targetPath);
+		const outgoingHeaders: Record<string, string | string[] | undefined> = { ...req.headers };
+
+		delete outgoingHeaders.host;
+		delete outgoingHeaders['content-length'];
+
+		// if (config.apiKey && !this.hasAuthorizationHeader(outgoingHeaders)) {
+		outgoingHeaders.authorization = `Bearer ${config.apiKey}`;
+		// }
+
+		if (config.headers) {
+			for (const [key, value] of Object.entries(config.headers)) {
+				outgoingHeaders[key.toLowerCase()] = value;
+			}
+		}
+
+		const bodyBuffer = await this.readRequestBody(req);
+		let forwardBody = bodyBuffer;
+		let requestPayload: any | undefined;
+
+		if (isClaudeMessages && bodyBuffer.length > 0) {
+			requestPayload = this.parseJson(bodyBuffer.toString('utf-8'));
+			const converted = this.convertClaudeToOpenAI(requestPayload, config);
+			forwardBody = Buffer.from(JSON.stringify(converted));
+		}
+
+		const requestFn = targetUrl.protocol === 'https:' ? httpsRequest : httpRequest;
+		const proxyReq = requestFn(targetUrl, { method: req.method, headers: { ...outgoingHeaders, 'content-length': String(forwardBody.length) } }, proxyRes => {
+
+			if (isClaudeMessages) {
+				this.handleClaudeResponse(proxyRes, res, config, requestPayload).catch(error => {
+					this.logService.error('DeployAI proxy Claude response failed:', error);
+					if (!res.headersSent) {
+						res.statusCode = 502;
+					}
+					res.end();
+				});
+				return;
+			}
+
+
+			res.writeHead(proxyRes.statusCode ?? 502, proxyRes.headers);
+			pipeline(proxyRes, res).catch(error => {
+				this.logService.error('DeployAI proxy response stream failed:', error);
+				res.end();
+			});
+		});
+
+		proxyReq.on('error', error => {
+			this.logService.error('DeployAI proxy upstream request failed:', error);
+			if (!res.headersSent) {
+				res.statusCode = 502;
+			}
+			res.end();
+		});
+
+		proxyReq.write(forwardBody);
+		proxyReq.end();
+	}
+
+	private resolveTargetUrl(endpoint: string, pathname: string): URL {
+		const base = new URL(endpoint);
+		if (!pathname || pathname === '/' || base.pathname !== '/') {
+			return base;
+		}
+
+		const baseWithSlash = endpoint.endsWith('/') ? endpoint : `${endpoint}/`;
+		return new URL(pathname, baseWithSlash);
+	}
+
+	// private hasAuthorizationHeader(headers: Record<string, string | string[] | undefined>): boolean {
+	// 	return Object.keys(headers).some(header => header.toLowerCase() === 'authorization');
+	// }
+
+	private async readRequestBody(req: IncomingMessage): Promise<Buffer> {
+		const chunks: Buffer[] = [];
+		for await (const chunk of req) {
+			chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));
+		}
+		return Buffer.concat(chunks);
+	}
+
+	private parseJson(value: string): any {
+		try {
+			return JSON.parse(value);
+		} catch (error) {
+			this.logService.error('DeployAI proxy JSON parse failed:', error);
+			return {};
+		}
+	}
+
+	private convertClaudeToOpenAI(payload: any, config: DeployAIProxyConfig): Record<string, unknown> {
+		const systemText = this.normalizeClaudeContent(payload?.system);
+		const messages: Array<{ role: string; content?: string; tool_calls?: Array<{ id: string; type: 'function'; function: { name: string; arguments: string } }>; tool_call_id?: string }> = [];
+
+		if (systemText) {
+			messages.push({ role: 'system', content: systemText });
+		}
+
+		for (const message of payload?.messages ?? []) {
+			const role = message?.role ?? 'user';
+			const content = message?.content;
+			if (typeof content === 'string') {
+				messages.push({ role, content });
+				continue;
+			}
+
+			if (Array.isArray(content)) {
+				if (role === 'user') {
+					const toolResults = content.filter((part: any) => part?.type === 'tool_result' && part?.tool_use_id);
+					for (const toolResult of toolResults) {
+						const toolContent = typeof toolResult.content === 'string' ? toolResult.content : JSON.stringify(toolResult.content ?? {});
+						messages.push({
+							role: 'tool',
+							content: toolContent,
+							tool_call_id: toolResult.tool_use_id
+						});
+					}
+
+					const textParts = content.filter((part: any) => part?.type === 'text' && typeof part.text === 'string');
+					const textContent = textParts.map((part: any) => part.text).join('');
+					if (textContent) {
+						messages.push({ role: 'user', content: textContent });
+					}
+					continue;
+				}
+
+				if (role === 'assistant') {
+					const textParts = content.filter((part: any) => part?.type === 'text' && typeof part.text === 'string');
+					const textContent = textParts.map((part: any) => part.text).join('');
+					const toolUseParts = content.filter((part: any) => part?.type === 'tool_use' && part?.id && part?.name);
+					const toolCalls = toolUseParts.map((part: any) => ({
+						id: part.id,
+						type: 'function' as const,
+						function: {
+							name: part.name,
+							arguments: JSON.stringify(part.input ?? {})
+						}
+					}));
+
+					const assistantMessage: { role: string; content?: string; tool_calls?: Array<{ id: string; type: 'function'; function: { name: string; arguments: string } }> } = {
+						role: 'assistant'
+					};
+					if (textContent) {
+						assistantMessage.content = textContent;
+					}
+					if (toolCalls.length) {
+						assistantMessage.tool_calls = toolCalls;
+					}
+					if (assistantMessage.content || assistantMessage.tool_calls) {
+						messages.push(assistantMessage);
+					}
+				}
+			}
+		}
+
+		const tools = this.mapClaudeTools(payload?.tools);
+		const toolChoice = this.mapClaudeToolChoice(payload?.tool_choice);
+
+		return {
+			model: config.model,
+			messages,
+			max_tokens: payload?.max_tokens,
+			temperature: payload?.temperature,
+			top_p: payload?.top_p,
+			stream: payload?.stream,
+			stream_options: payload?.stream_options,
+			stop: payload?.stop,
+			tools,
+			tool_choice: toolChoice
+		};
+	}
+
+	private normalizeClaudeContent(content: unknown): string {
+		if (!content) {
+			return '';
+		}
+
+		if (typeof content === 'string') {
+			return content;
+		}
+
+		if (Array.isArray(content)) {
+			return content
+				.filter(block => block && block.type === 'text' && typeof block.text === 'string')
+				.map(block => block.text)
+				.join('');
+		}
+
+		return '';
+	}
+
+	private mapClaudeTools(tools: any): Array<{ type: 'function'; function: { name: string; description?: string; parameters?: Record<string, unknown> } }> | undefined {
+		if (!Array.isArray(tools) || tools.length === 0) {
+			return undefined;
+		}
+
+		const mapped = tools
+			.map(tool => {
+				const name = tool?.name;
+				if (!name) {
+					return undefined;
+				}
+				return {
+					type: 'function' as const,
+					function: {
+						name,
+						description: tool?.description,
+						parameters: tool?.input_schema
+					}
+				};
+			})
+			.filter(Boolean) as Array<{ type: 'function'; function: { name: string; description?: string; parameters?: Record<string, unknown> } }>;
+
+		return mapped.length ? mapped : undefined;
+	}
+
+	private mapClaudeToolChoice(toolChoice: any): unknown {
+		if (!toolChoice) {
+			return undefined;
+		}
+
+		if (typeof toolChoice === 'string') {
+			return toolChoice;
+		}
+
+		if (toolChoice?.type === 'tool' && toolChoice?.name) {
+			return { type: 'function', function: { name: toolChoice.name } };
+		}
+
+		return toolChoice;
+	}
+
+	private estimateClaudeTokens(payload: any): number {
+		const parts: string[] = [];
+		const systemText = this.normalizeClaudeContent(payload?.system);
+		if (systemText) {
+			parts.push(systemText);
+		}
+
+		for (const message of payload?.messages ?? []) {
+			const content = this.normalizeClaudeContent(message?.content);
+			if (content) {
+				parts.push(content);
+			}
+		}
+
+		const text = parts.join(' ');
+		if (!text) {
+			return 0;
+		}
+
+		return text.split(/\s+/).filter(Boolean).length;
+	}
+
+	private async handleClaudeResponse(
+		proxyRes: IncomingMessage,
+		res: ServerResponse,
+		config: DeployAIProxyConfig,
+		requestPayload?: any
+	): Promise<void> {
+		if ((proxyRes.statusCode ?? 200) >= 400) {
+			res.writeHead(proxyRes.statusCode ?? 502, proxyRes.headers);
+			await pipeline(proxyRes, res);
+			return;
+		}
+
+		const isStream = Boolean(requestPayload?.stream) || String(proxyRes.headers['content-type'] ?? '').includes('text/event-stream');
+
+		if (!isStream) {
+			const responseBody = await this.readResponseBody(proxyRes);
+			const openAIResponse = this.parseJson(responseBody.toString('utf-8'));
+			const claudeResponse = this.convertOpenAIToClaude(openAIResponse, config.model);
+			const payload = Buffer.from(JSON.stringify(claudeResponse));
+
+			res.writeHead(proxyRes.statusCode ?? 200, {
+				'content-type': 'application/json',
+				'content-length': String(payload.length)
+			});
+			res.end(payload);
+			return;
+		}
+
+		res.writeHead(200, {
+			'content-type': 'text/event-stream',
+			'cache-control': 'no-cache',
+			connection: 'keep-alive'
+		});
+
+		const sendEvent = (event: string, data: unknown): void => {
+			res.write(`event: ${event}\n`);
+			res.write(`data: ${JSON.stringify(data)}\n\n`);
+		};
+
+		const messageId = `msg_${Date.now()}_${Math.random().toString(16).slice(2)}`;
+		const model = config.model;
+
+		sendEvent('message_start', {
+			type: 'message_start',
+			message: {
+				id: messageId,
+				type: 'message',
+				role: 'assistant',
+				model,
+				content: [],
+				stop_reason: null,
+				stop_sequence: null,
+				usage: {
+					input_tokens: 0,
+					output_tokens: 0
+				}
+			}
+		});
+
+		let contentStarted = false;
+		let currentBlockType: 'text' | 'tool' | undefined;
+		let currentBlockIndex: number | undefined;
+		let nextContentIndex = 0;
+		let stopReason: string | null = null;
+		let streamError: any | undefined;
+		let finalUsage: { input_tokens: number; output_tokens: number; cache_read_input_tokens?: number } | undefined;
+		const toolCallIndexToBlockIndex = new Map<number, number>();
+		const toolCalls = new Map<number, { id: string; name: string; arguments: string }>();
+
+		await this.consumeOpenAIStream(proxyRes, (chunk) => {
+			if (chunk?.error) {
+				streamError = chunk.error;
+				return;
+			}
+			// this.logService.info(`DeployAI proxy SSE chunk: ${JSON.stringify(chunk)}`);
+			const choice = chunk?.choices?.[0];
+			if (chunk?.usage) {
+				finalUsage = {
+					input_tokens: (chunk.usage?.prompt_tokens || 0) - (chunk.usage?.prompt_tokens_details?.cached_tokens || 0),
+					output_tokens: chunk.usage?.completion_tokens || 0,
+					cache_read_input_tokens: chunk.usage?.prompt_tokens_details?.cached_tokens || 0
+				};
+			}
+			const deltaText = choice?.delta?.content;
+			const deltaToolCalls = choice?.delta?.tool_calls;
+			if (typeof deltaText === 'string' && deltaText.length > 0) {
+				if (!contentStarted || currentBlockType !== 'text') {
+					if (currentBlockIndex !== undefined) {
+						sendEvent('content_block_stop', { type: 'content_block_stop', index: currentBlockIndex });
+					}
+					contentStarted = true;
+					currentBlockType = 'text';
+					currentBlockIndex = nextContentIndex++;
+					sendEvent('content_block_start', {
+						type: 'content_block_start',
+						index: currentBlockIndex,
+						content_block: { type: 'text', text: '' }
+					});
+				}
+
+				sendEvent('content_block_delta', {
+					type: 'content_block_delta',
+					index: currentBlockIndex,
+					delta: { type: 'text_delta', text: deltaText }
+				});
+			}
+
+			if (Array.isArray(deltaToolCalls)) {
+				const processedInChunk = new Set<number>();
+				for (const toolCall of deltaToolCalls) {
+					const index = typeof toolCall?.index === 'number' ? toolCall.index : 0;
+					if (processedInChunk.has(index)) {
+						continue;
+					}
+					processedInChunk.add(index);
+
+					const existingBlock = toolCallIndexToBlockIndex.get(index);
+					const name = toolCall?.function?.name ?? toolCall?.name ?? toolCalls.get(index)?.name;
+					const id = toolCall?.id ?? toolCalls.get(index)?.id ?? `tool_${index}`;
+
+					if (existingBlock === undefined && name) {
+						if (currentBlockIndex !== undefined) {
+							sendEvent('content_block_stop', { type: 'content_block_stop', index: currentBlockIndex });
+						}
+						currentBlockType = 'tool';
+						currentBlockIndex = nextContentIndex++;
+						toolCallIndexToBlockIndex.set(index, currentBlockIndex);
+						toolCalls.set(index, { id, name, arguments: '' });
+
+						sendEvent('content_block_start', {
+							type: 'content_block_start',
+							index: currentBlockIndex,
+							content_block: { type: 'tool_use', id, name, input: {} }
+						});
+					} else if (name && id) {
+						toolCalls.set(index, { id, name, arguments: toolCalls.get(index)?.arguments ?? '' });
+					}
+
+					const argsPart = toolCall?.function?.arguments;
+					if (typeof argsPart === 'string' && argsPart.length > 0) {
+						const blockIndex = toolCallIndexToBlockIndex.get(index);
+						if (blockIndex === undefined) {
+							continue;
+						}
+						const toolState = toolCalls.get(index);
+						if (toolState) {
+							toolState.arguments += argsPart;
+						}
+						sendEvent('content_block_delta', {
+							type: 'content_block_delta',
+							index: blockIndex,
+							delta: { type: 'input_json_delta', partial_json: argsPart }
+						});
+					}
+				}
+			}
+
+			if (choice?.finish_reason) {
+				stopReason = this.mapFinishReason(choice.finish_reason);
+			}
+		});
+
+		if (streamError) {
+			sendEvent('error', { type: 'error', error: streamError });
+			res.end();
+			return;
+		}
+
+		if (currentBlockIndex !== undefined) {
+			sendEvent('content_block_stop', { type: 'content_block_stop', index: currentBlockIndex });
+		}
+
+		sendEvent('message_delta', {
+			type: 'message_delta',
+			delta: { stop_reason: stopReason ?? 'end_turn', stop_sequence: null },
+			usage: finalUsage ?? { input_tokens: 0, output_tokens: 0, cache_read_input_tokens: 0 }
+		});
+		sendEvent('message_stop', { type: 'message_stop' });
+		res.end();
+	}
+
+	private async readResponseBody(res: IncomingMessage): Promise<Buffer> {
+		const chunks: Buffer[] = [];
+		for await (const chunk of res) {
+			chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));
+		}
+		return Buffer.concat(chunks);
+	}
+
+	private convertOpenAIToClaude(payload: any, model: string): Record<string, unknown> {
+		const choice = payload?.choices?.[0];
+		const contentText = choice?.message?.content ?? '';
+		const toolCalls = choice?.message?.tool_calls ?? [];
+		const finishReason = choice?.finish_reason ? this.mapFinishReason(choice.finish_reason) : null;
+		const usage = payload?.usage ?? {};
+
+		const content: Array<{ type: string; [key: string]: unknown }> = [];
+		if (contentText) {
+			content.push({ type: 'text', text: contentText });
+		}
+		for (const toolCall of toolCalls) {
+			if (!toolCall?.function?.name) {
+				continue;
+			}
+			let parsedInput: unknown = {};
+			const args = toolCall?.function?.arguments;
+			if (typeof args === 'string') {
+				try {
+					parsedInput = JSON.parse(args);
+				} catch {
+					parsedInput = { text: args };
+				}
+			} else if (args) {
+				parsedInput = args;
+			}
+			content.push({
+				type: 'tool_use',
+				id: toolCall?.id ?? `tool_${Date.now()}`,
+				name: toolCall.function.name,
+				input: parsedInput
+			});
+		}
+
+		return {
+			id: payload?.id ?? `msg_${Date.now()}`,
+			type: 'message',
+			role: 'assistant',
+			model: model,
+			content,
+			stop_reason: finishReason,
+			stop_sequence: null,
+			usage: {
+				input_tokens: usage.prompt_tokens ?? 0,
+				output_tokens: usage.completion_tokens ?? 0
+			}
+		};
+	}
+
+	private async consumeOpenAIStream(res: IncomingMessage, onChunk: (chunk: any) => void): Promise<void> {
+		let buffer = '';
+		let dataLines: string[] = [];
+
+		for await (const chunk of res) {
+			buffer += chunk.toString('utf-8');
+			// this.logService.info(`DeployAI proxy SSE raw chunk: ${chunk.toString('utf-8')}`);
+			const lines = buffer.split(/\r?\n/);
+			buffer = lines.pop() ?? '';
+
+			for (const line of lines) {
+				if (line === '') {
+					if (dataLines.length > 0) {
+						const data = dataLines.join('\n');
+						dataLines = [];
+						if (data === '[DONE]') {
+							return;
+						}
+						onChunk(this.parseJson(data));
+					}
+					continue;
+				}
+
+				if (line.startsWith('data:')) {
+					dataLines.push(line.slice(5).trimStart());
+				} else if (line.startsWith('{') || line.startsWith('[')) {
+					dataLines.push(line);
+				}
+			}
+		}
+
+		if (dataLines.length > 0) {
+			const data = dataLines.join('\n');
+			if (data !== '[DONE]') {
+				onChunk(this.parseJson(data));
+			}
+		}
+	}
+
+	private mapFinishReason(reason: string): string {
+		switch (reason) {
+			case 'stop':
+				return 'end_turn';
+			case 'length':
+				return 'max_tokens';
+			case 'tool_calls':
+				return 'tool_use';
+			default:
+				return 'end_turn';
+		}
+	}
+}
